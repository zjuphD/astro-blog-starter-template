    if (e.key === "ArrowDown") target = items[(i + 1) % items.length];
    if (e.key === "ArrowUp") target = items[(i + items.length - 1) % items.length];
    if (e.key === "Home") target = items[0]; if (e.key === "End") target = items[items.length - 1];
