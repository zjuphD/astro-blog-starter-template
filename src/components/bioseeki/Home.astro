  </defs>
</svg>

<nav class="nav" id="nav" aria-label={t.nav.aria}>
  <a class="brand" href="#top" aria-label={t.nav.home}>
    <img class="brand-mark logo-img" src="/bioseeki/mark.webp" alt="">
    <span class="brand-name">BIOSEEKI</span>
    <span class="brand-sub">RESEARCH WORKSPACE</span>
  </a>
  <div class="nav-links">
    {t.nav.items.map(([href, label]) => <a href={href}>{label}</a>)}
  </div>
  <div class="nav-actions">
    <a class="lang-switch" href={t.switchTo.href} hreflang={lang === "zh" ? "en" : "zh-CN"} title={t.switchTo.title} lang={lang === "zh" ? "en" : "zh-CN"}>{t.switchTo.label}</a>
    <a class="nav-login" id="navLogin" href={t.links.signIn}>{t.nav.signIn}</a>
    <a class="btn btn-ghost btn-sm nav-signup" id="navSignup" href={t.links.signUp}><Label text={t.nav.signUp} /></a>
    {/* 已登录时由脚本换成这个（读 bs_name cookie，见文件末尾的 inline script） */}
    <div class="nav-account" id="navAccount" hidden>
      <button class="nav-user" id="navUser" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="navAccountMenu" aria-label={lang === 'zh' ? '账户菜单' : 'Account menu'}><span class="nav-avatar" id="navAvatar">·</span><span class="nav-uname" id="navUname">{t.nav.personal}</span><svg class="nav-user-chevron" aria-hidden="true" viewBox="0 0 16 16"><path d="m4 6 4 4 4-4"/></svg></button>
      <div class="nav-account-menu" id="navAccountMenu" role="menu" hidden aria-label={lang === 'zh' ? '账户操作' : 'Account actions'}>
        <a role="menuitem" href="https://api.bioseeki.com/me"><svg aria-hidden="true" viewBox="0 0 20 20"><circle cx="10" cy="6" r="3"/><path d="M4 17v-2a6 6 0 0 1 12 0v2"/></svg>{lang === 'zh' ? '个人中心' : 'Account'}</a>
        <a role="menuitem" href="https://api.bioseeki.com/me?action=logout"><svg aria-hidden="true" viewBox="0 0 20 20"><path d="M8 3H4v14h4M8 10h9m-4-4 4 4-4 4"/></svg>{lang === 'zh' ? '退出登录' : 'Sign out'}</a>
      </div>
    </div>
    <a class="btn btn-primary btn-sm nav-dl" href={dlHref} download={dlAttr}><svg class="btn-ico btn-ico-fill" aria-hidden="true"><use href="#i-apple"/></svg>{t.nav.download}</a>
  </div>
</nav>

<header class="hero" id="top">
  {heroVideo && <div class="hero-video" aria-hidden="true">
    <video class="hv hv-light" muted loop playsinline preload="none" poster="/bioseeki/hero-loop-light.jpg" data-hero-video>
      <source src="/bioseeki/hero-loop-light.webm" type="video/webm"><source src="/bioseeki/hero-loop-light.mp4" type="video/mp4">
    </video>
    <video class="hv hv-dark" muted loop playsinline preload="none" poster="/bioseeki/hero-loop-dark.jpg" data-hero-video>
      <source src="/bioseeki/hero-loop-dark.webm" type="video/webm"><source src="/bioseeki/hero-loop-dark.mp4" type="video/mp4">
    </video>
  </div>}
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <p class="eyebrow reveal" style="--d:.04s">{t.hero.eyebrow}</p>
        <h1 class="reveal" style="--d:.08s"><span class="line">{t.hero.h1a}</span><span class="line"><em>{t.hero.h1b}</em>{lang === "zh" ? "。" : "."}</span></h1>
        <p class="hero-sub reveal" style="--d:.16s" set:html={t.hero.sub} />
        <div class="hero-ctas reveal" style="--d:.24s">
          <a class="btn btn-primary" href={dlHref} download={dlAttr}><svg class="btn-ico btn-ico-fill" aria-hidden="true"><use href="#i-apple"/></svg>{t.hero.download}</a>
          <a class="btn btn-ghost" href={t.links.signUp}><Label text={t.hero.cta} /></a>
        </div>
        <p class="hero-meta reveal" style="--d:.28s"><span>{t.hero.meta}</span><a class="hero-demo" href="#demo"><Label text={t.hero.demo} /></a></p>
      </div>
    </div>
  </div>
</header>

<div class="index" aria-hidden="true"><div class="wrap index-row">
  {t.ticker.map((w, i) => <>{i > 0 && <i></i>}<span>{w}</span></>)}
</div></div>

<section id="tools"><div class="wrap">
  <div class="section-head reveal"><p class="eyebrow"><span class="section-num">01</span> · {t.tools.eyebrow}</p><h2 class="section-title">{t.tools.title}</h2><p class="section-lede">{t.tools.lede}</p></div>
  <article class="glass suite reveal">
    <div class="suite-feature">
      <div class="feature-text">
        <div class="card-top"><span class="card-id">GC / MOLECULAR DESIGN</span><span class="status status-live"><Label text={t.tools.gc.status} /></span></div>
        <h3>{t.tools.gc.h}</h3><p>{t.tools.gc.p}</p>
        <a class="card-link" href="https://genecode-agent.pages.dev" target="_blank" rel="noopener noreferrer"><Label text={t.tools.gc.link} /></a>
      </div>
      <svg class="plasmid" viewBox="0 0 320 300" role="img" aria-label={`${t.tools.gc.h} · pUC19 · 2,686 bp`}>
        <circle cx={PL.cx} cy={PL.cy} r={PL.r} class="pl-ring"/>
        {plTicks.map((k) => <path class={`pl-tick${k.major ? " major" : ""}`} d={k.d}/>)}
        {plNums.map((n) => <text x={n.x} y={n.y + (n.anchor === "middle" ? 4 : 0)} class="pl-num" text-anchor={n.anchor}>{n.label}</text>)}
        {plFeatures.map((f) => <path class={f.cls} d={f.d}/>)}
        {plCuts.map((d) => <path class="pl-cut" d={d}/>)}
        <path class="pl-lead" d={`M${plMcs[0]} ${plMcs[1]}V30`}/>
        <text x={plMcs[0]} y="22" class="pl-lab" text-anchor="middle">HindIII · BamHI · EcoRI</text>
        {plLabels.map((l) => <text x={l.at[0] + l.dx} y={l.at[1] + 4 + (l.dy ?? 0)} class="pl-lab" text-anchor={l.anchor}>{l.text}</text>)}
        <text x={PL.cx} y={PL.cy + 2} class="pl-name" text-anchor="middle">pUC19</text>
        <text x={PL.cx} y={PL.cy + 21} class="pl-sub" text-anchor="middle">2,686 bp</text>
      </svg>
    </div>
    <ul class="suite-modes">
      {t.tools.modes.map((m) => (
        <li class="mode">
          <div class="ico-box" aria-hidden="true"><svg class="ico"><use href={`#${m.icon}`}/></svg></div>
          <div><h3>{m.h}</h3><p>{m.p}</p></div>
        </li>
      ))}
    </ul>
  </article>
</div></section>

<section id="verify"><div class="wrap">
  <div class="section-head reveal"><p class="eyebrow"><span class="section-num">02</span> · {t.verify.eyebrow}</p><h2 class="section-title">{t.verify.title}</h2><p class="section-lede">{t.verify.lede}</p></div>
  <div class="verify-grid">
    <div class="verify-cards">
      {t.verify.cards.map((c, i) => (
        <article class="verify-card reveal" style={`--d:${(i * 0.07).toFixed(2)}s`}><div class="ico-box" aria-hidden="true"><svg class="ico"><use href={`#${c.icon}`}/></svg></div><h3>{c.h}</h3><p>{c.p}</p></article>
      ))}
    </div>
    <aside class="glass report reveal" style="--d:.12s" aria-label={t.verify.reportAria}>
      <div class="report-bar"><span class="report-cmd">citecheck --bib refs.bib</span><span class="badge-quiet">{t.verify.illustrative}</span></div>
      <div class="report-body">
        {t.verify.report.map(([cls, verdict, text], i) => (
          <div class="rrow"><span class={`verdict ${cls}`}><Label text={verdict} verdict /></span><p class="rtext"><small>[{i + 1}]</small>{text}</p></div>
        ))}
      </div>
      <div class="report-foot"><span>{t.verify.reportFootL}</span><span><Label text={t.verify.reportFootR} /></span></div>
    </aside>
  </div>
</div></section>

<section id="principles"><div class="wrap">
  <div class="section-head reveal"><p class="eyebrow"><span class="section-num">03</span> · {t.principles.eyebrow}</p><h2 class="section-title">{t.principles.title}</h2><p class="section-lede">{t.principles.lede}</p></div>
  <figure class="glass chain reveal" aria-label={t.principles.chain.aria} data-chain>
    <div class="chain-bar"><span class="panel-title">{t.principles.chain.title}</span><span class="chain-legend"><i></i><Fragment set:html={glyphHtml(t.principles.chain.cols.join(" → "))} /></span></div>
    <div class="chain-grid">
      <svg class="chain-wires" aria-hidden="true"></svg>
      <div class="chain-col">
        <p class="chain-h">{t.principles.chain.cols[0]}</p>
        <ul class="chain-sources">{t.principles.chain.sources.map((s, i) => <li data-src={i}>{s}</li>)}</ul>
      </div>
      <div class="chain-col">
        <p class="chain-h">{t.principles.chain.cols[1]}</p>
        <div class="chain-core" data-core>
          {t.principles.chain.fragments.map(([file, loc], i) => (
            <div class="frag" data-frag={i}><span class="frag-file">{file}</span><span class="frag-loc">{loc}</span></div>
          ))}
          <p class="frag-note">{t.principles.chain.fragNote}</p>
        </div>
      </div>
      <div class="chain-col">
        <p class="chain-h">{t.principles.chain.cols[2]}</p>
        <div class="chain-draft">
          {t.principles.chain.claims.map(([text, ref], i) => (
            <p class="claim" data-claim={i}>{text}<span class="claim-ref">{ref}</span></p>
          ))}
          <p class="claim claim-gap">{t.principles.chain.gap}</p>
        </div>
      </div>
    </div>
    <figcaption class="chain-foot">{t.principles.chain.foot}</figcaption>
  </figure>
  <div class="principles-grid">
    {t.principles.cards.map((c, i) => (
      <article class="principle reveal" style={`--d:${(i * 0.1).toFixed(2)}s`}>
        <div class="principle-head"><div class="ico-box" aria-hidden="true"><svg class="ico"><use href={`#${c.icon}`}/></svg></div><span class="principle-num">{c.num}</span></div>
        <div><h3>{c.h}</h3><p>{c.p}</p></div>
      </article>
    ))}
  </div>
</div></section>

<section id="workflow"><div class="wrap">
  <div class="section-head reveal"><p class="eyebrow"><span class="section-num">04</span> · {t.workflow.eyebrow}</p><h2 class="section-title">{t.workflow.title}</h2><p class="section-lede">{t.workflow.lede}</p></div>
  <div class="case">
    <aside class="glass case-card reveal">
      <p class="case-label">{t.workflow.case.label}</p>
      <p class="case-q">{t.workflow.case.question}</p>
      <dl class="case-meta">{t.workflow.case.meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <ul class="case-stats">{t.workflow.case.stats.map(([n, l], i) => <li class={i === 3 ? "is-gap" : ""}><b>{n}</b><span>{l}</span></li>)}</ul>
      <p class="case-note">{t.workflow.case.note}</p>
    </aside>
    <ol class="glass log reveal" style="--d:.08s">
      {t.workflow.steps.map((s, i) => (
        <li class={`log-step${s.confirm ? " ask" : ""}`}>
          <span class="log-n">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3>{s.h}</h3>
            <p class="log-out">{s.out}</p>
            {s.confirm && <p class="log-confirm"><span>{t.workflow.confirmLabel}</span>{s.confirm}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
  <div class="glass bounds reveal">
    {t.workflow.bounds.map((b) => (
      <article class="bound"><div class="ico-box" aria-hidden="true"><svg class="ico"><use href={`#${b.icon}`}/></svg></div><div><h3>{b.h}</h3><p>{b.p}</p></div></article>
    ))}
  </div>
</div></section>

<section id="demo"><div class="wrap"><div class="section-head reveal"><p class="eyebrow"><span class="section-num">05</span> · {t.demo.eyebrow}</p><h2 class="section-title">{t.demo.title}</h2><p class="section-lede">{t.demo.lede}</p></div>
<div class="glass demo-glass reveal">
  <div class="demo-bar"><span class="panel-title">BIOSEEKI / PRODUCT DEMO</span><span class="badge-live">{t.demo.badge}</span></div>
  {/* Without JS the native controls stay; the script swaps them for the play button until the first play. */}
  <div class="player" data-player>
    <video controls playsinline preload="none" poster="/bioseeki/demo-poster.jpg" aria-label={t.demo.aria}><source src="/bioseeki/demo.mp4" type="video/mp4"><track kind="captions" src="/bioseeki/captions.zh.vtt" srclang="zh" label={t.demo.captionsLabel}>{t.demo.fallback}<a href="/bioseeki/demo.mp4">{t.demo.download}</a></video>
    <button class="play" type="button" hidden data-play><span class="play-pill"><span class="play-ico"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 1.9v12.2L13.8 8z"/></svg></span><span class="play-txt">{t.demo.play}<small>{t.demo.badge}</small></span></span></button>
  </div>
  <div class="demo-foot"><span>{t.demo.foot}</span><a href="/bioseeki/demo.mp4" download><Label text={t.demo.download} /></a></div>
</div>
</div></section>

<section id="download"><div class="wrap"><div class="section-head reveal"><p class="eyebrow"><span class="section-num">06</span> · {t.download.eyebrow}</p><h2 class="section-title">{t.download.title}</h2><p class="section-lede">{t.download.lede}</p></div>
<div class="get">
  <article class="glass dl reveal">
    <div class="dl-top">
      <img class="dl-mark logo-img" src="/bioseeki/mark.webp" alt="" width="34" height="43">
      <p class="dl-app">{t.download.app}</p>
      <span class="badge-live">{t.download.badge}</span>
    </div>
    <dl class="dl-specs">
      {t.download.specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
    <p class="dl-note">{t.download.note}</p>
    <div class="dl-actions">
      {MAC_DMG_URL
        ? <a class="btn btn-primary dl-btn" href={MAC_DMG_URL} download><svg class="btn-ico btn-ico-fill" aria-hidden="true"><use href="#i-apple"/></svg>{t.download.cta}</a>
        : <>
            <p class="dl-soon"><span class="live-dot" aria-hidden="true"></span>{t.download.soon}</p>
            <a class="btn btn-primary dl-btn" href={mailto}><Label text={t.download.mailCta} /></a>
          </>}
    </div>
    <p class="dl-legal" set:html={t.download.legal} />
  </article>
  <div class="steps3-wrap reveal" style="--d:.12s">
    <p class="eyebrow steps3-label">{t.download.stepsLabel}</p>
    <ol class="steps3">
      {t.download.steps.map(([n, h, d], i) => (
        <li class={`step3${i === 0 ? " live" : ""}`}>
          <span class="step3-n">{n}</span>
          <div><h3>{h}</h3><p>{d}</p>{i === 0 ? <a class="btn btn-ghost btn-sm" href={t.links.signUp}><Label text={t.download.signUp} /></a> : null}</div>
        </li>
      ))}
    </ol>
  </div>
</div>
</div></section>

<section id="pricing"><div class="wrap"><div class="section-head reveal"><p class="eyebrow"><span class="section-num">07</span> · {t.pricing.eyebrow}</p><h2 class="section-title">{t.pricing.title}</h2><p class="section-lede">{t.pricing.lede}</p></div>
<div class="plans">
  {t.pricing.plans.map((p, i) => (
    <article class={`glass plan reveal${p.tag ? " hot" : ""}`} style={`--d:${(i * 0.12).toFixed(2)}s`}>
      <div class="plan-head"><p class="plan-name">{p.name}</p>{p.tag ? <span class="plan-tag">{p.tag}</span> : null}</div>
      <p class="plan-price"><span class="plan-cur">¥</span><b>{p.price}</b><span class="plan-per">{t.pricing.per}</span></p>
      <p class="plan-credits"><b>{p.credits}</b> credits</p>
      <span class="plan-meter" aria-hidden="true"><i style={`width:${Math.round((creditsOf(p.credits) / maxCredits) * 100)}%`}></i></span>
      <p class="plan-sub">{p.sub}</p>
      <a class={`btn plan-cta ${p.tag ? "btn-primary" : "btn-ghost"}`} href={t.links.plans}><Label text={t.pricing.cta} /></a>
    </article>
  ))}
</div>
</div></section>

<section id="faq"><div class="wrap"><div class="faq-grid">
  <div class="section-head reveal" style="margin-bottom:0"><p class="eyebrow"><span class="section-num">08</span> · {t.faq.eyebrow}</p><h2 class="section-title">{t.faq.title}</h2><p class="section-lede" set:html={glyphHtml(t.faq.lede, { html: true })} /></div>
  <div class="glass faq-list reveal">
    {t.faq.items.map((f, i) => (
      <details class="faq" open={i === 0}>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</div></div></section>

<footer><div class="wrap"><div class="glass foot-card reveal">
  <div class="foot-brand"><img class="logo-img" src="/bioseeki/mark.webp" alt="" width="42" height="52"><span>BioSeeki</span></div>
  <p class="foot-tag">{t.footer.tagA}<em>{t.footer.tagB}</em></p>
  <p class="foot-slogan">{t.footer.slogan}</p>
  <nav class="foot-cols" aria-label={t.footer.aria}>
    {t.footer.groups.map((g) => (
      <div class="foot-col">
        <p class="foot-col-title">{g.title}</p>
        <ul>
          {g.links.map(([href, label, flag]) => (
            <li><a href={href} target={flag === "ext" ? "_blank" : undefined} rel={flag === "ext" ? "noopener noreferrer" : undefined}><Label text={label} /></a></li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
  <div class="foot-bar">
    <p class="copy">{t.footer.copy}</p>
    <div class="foot-bar-r">
      <a class="lang-switch" href={t.switchTo.href} hreflang={lang === "zh" ? "en" : "zh-CN"}>{t.switchTo.label}</a>
      <a class="foot-top" href="#top"><Label text={t.footer.top} /></a>
    </div>
  </div>
</div></div></footer>

<script is:inline>
(function(){
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* scroll reveal */
  var revealed = document.querySelectorAll(".reveal");
  if (reduced || !("IntersectionObserver" in window)) {
    revealed.forEach(function(el){ el.classList.add("in"); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); }
      });
    }, { threshold:.15, rootMargin:"0px 0px -40px 0px" });
    revealed.forEach(function(el){ io.observe(el); });
  }

  /* nav glass on scroll */
  var nav = document.getElementById("nav");
  var onScroll = function(){ nav.classList.toggle("scrolled", window.scrollY > 24); };
  window.addEventListener("scroll", onScroll, { passive:true });
  onScroll();

  /* nav: mark the section that crosses the upper-middle of the viewport */
  var links = Array.prototype.slice.call(document.querySelectorAll('.nav-links a[href^="#"]'));
  var targets = links.map(function(a){ return document.getElementById(a.getAttribute("href").slice(1)); });
  var spyQueued = false;
  function spy(){
    spyQueued = false;
    var line = window.innerHeight * 0.45;
    links.forEach(function(a, i){
      var t = targets[i], r = t && t.getBoundingClientRect();
      if (r && r.top <= line && r.bottom > line) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    });
  }
  window.addEventListener("scroll", function(){ if (!spyQueued){ spyQueued = true; requestAnimationFrame(spy); } }, { passive:true });
  spy();

  var finePointer = window.matchMedia("(hover:hover) and (pointer:fine)").matches;

  /* cursor light: a soft glow and a patch of lit grid trail the pointer; the glass panel
     under it gets a spotlight and a lit stretch of edge. Mouse/trackpad only, never with
     reduced motion. */
  if (finePointer && !reduced){
    var root = document.documentElement;
    var glow = document.querySelector(".cfx-glow"), grid = document.querySelector(".cfx-grid");
    document.querySelectorAll(".glass").forEach(function(el){ el.classList.add("spot"); });
    document.querySelectorAll(".suite, .report, .chain, .case-card, .log, .bounds, .demo-glass, .dl, .plan, .faq-list, .foot-card").forEach(function(el){ el.classList.add("spot-edge"); });
    var tx = 0, ty = 0, g1 = { x:0, y:0 };
    var running = false;
    var mod = function(a, n){ return ((a % n) + n) % n; };
    var kick = function(){ if (!running){ running = true; requestAnimationFrame(frame); } };
    var frame = function(){
      g1.x += (tx - g1.x) * .12; g1.y += (ty - g1.y) * .12;
      glow.style.transform = "translate3d(" + g1.x + "px," + g1.y + "px,0)";
      /* the lit grid sits on the pointer; offset its pattern so the lines match the
         background grid (.orbs::before: centred horizontally, anchored at the top) */
      var vw = root.clientWidth, gs = vw >= 768 ? 56 : 40;
      grid.style.transform = "translate3d(" + tx + "px," + ty + "px,0)";
      grid.style.backgroundPosition = mod((vw - gs) / 2 - (tx - 210), gs) + "px " + mod(-(ty - 210), gs) + "px";
      var busy = Math.abs(tx - g1.x) + Math.abs(ty - g1.y) > .5;
      if (busy) requestAnimationFrame(frame); else running = false;
    };
    window.addEventListener("pointermove", function(e){
      if (e.pointerType === "touch") return;
      tx = e.clientX; ty = e.clientY;
      if (!root.classList.contains("fx-on")){ g1.x = tx; g1.y = ty; root.classList.add("fx-on"); }
      root.classList.remove("fx-away");
      var card = e.target.closest ? e.target.closest(".spot") : null;
      if (card){
        var r = card.getBoundingClientRect();
        card.style.setProperty("--sx", (tx - r.left) + "px");
        card.style.setProperty("--sy", (ty - r.top) + "px");
      }
      kick();
    }, { passive:true });
    document.addEventListener("mouseleave", function(){ root.classList.add("fx-away"); });
    window.addEventListener("blur", function(){ root.classList.add("fx-away"); });
  }

  /* evidence chain: draw wires from each source to the knowledge base and from each
     fragment to the claim it supports, measured from the live layout so they follow
     reflow (three columns on desktop, stacked on phones) */
  var chain = document.querySelector("[data-chain]");
  if (chain){
    var chainGrid = chain.querySelector(".chain-grid"), svg = chain.querySelector(".chain-wires");
    var NS = "http://www.w3.org/2000/svg";
    var drawWires = function(){
      var g = chainGrid.getBoundingClientRect();
      var core = chain.querySelector("[data-core]").getBoundingClientRect();
      var stacked = core.top > chain.querySelector("[data-src]").getBoundingClientRect().bottom;
      var html = "";
      var wire = function(kind, d){ html += '<g class="wire-' + kind + '"><path class="wire" d="' + d + '"/><path class="wire-flow" d="' + d + '"/></g>'; };
      if (stacked){
        // phones: one clean vertical link between each stage instead of per-item wires
        var blocks = [chain.querySelector(".chain-sources"), chain.querySelector("[data-core]"), chain.querySelector(".chain-draft")].map(function(el){ return el.getBoundingClientRect(); });
        for (var k = 0; k < 2; k++){
          var x = g.width / 2, y1 = blocks[k].bottom - g.top + 4, y2 = blocks[k + 1].top - g.top - 4;
          wire(k ? "out" : "in", "M" + x + " " + y1 + " L" + x + " " + y2);
        }
      } else {
        var srcs = chain.querySelectorAll("[data-src]");
        srcs.forEach(function(el, i){
          var a = el.getBoundingClientRect(), f = srcs.length > 1 ? i / (srcs.length - 1) : 0.5;
          var sx = a.right - g.left, sy = a.top + a.height / 2 - g.top;
          // sources fan into the knowledge base across its height, in order
          var ex = core.left - g.left, ey = core.top - g.top + core.height * (0.14 + 0.72 * f), mx = (sx + ex) / 2;
          wire("in", "M" + sx + " " + sy + " C" + mx + " " + sy + "," + mx + " " + ey + "," + ex + " " + ey);
        });
        chain.querySelectorAll("[data-frag]").forEach(function(el){
          var claim = chain.querySelector('[data-claim="' + el.getAttribute("data-frag") + '"]');
          if (!claim) return;
          var a = el.getBoundingClientRect(), c = claim.getBoundingClientRect();
          var sx = a.right - g.left, sy = a.top + a.height / 2 - g.top, ex = c.left - g.left, ey = c.top + c.height / 2 - g.top, mx = (sx + ex) / 2;
          wire("out", "M" + sx + " " + sy + " C" + mx + " " + sy + "," + mx + " " + ey + "," + ex + " " + ey);
        });
      }
      svg.setAttribute("viewBox", "0 0 " + g.width + " " + g.height);
      svg.innerHTML = html;
    };
    drawWires();
    var wireQueued = false;
    window.addEventListener("resize", function(){ if (!wireQueued){ wireQueued = true; requestAnimationFrame(function(){ wireQueued = false; drawWires(); }); } });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(drawWires);
  }

  /* demo: our play button over the poster; the native controls take over from the first play */
  var player = document.querySelector("[data-player]");
  if (player){
    var pv = player.querySelector("video"), pb = player.querySelector("[data-play]");
    var started = function(){ player.classList.add("playing"); pv.controls = true; };
    pv.controls = false; pb.hidden = false;
    pb.addEventListener("click", function(){ started(); var p = pv.play(); if (p && p.catch) p.catch(function(){}); pv.focus(); });
    pv.addEventListener("play", started);
  }

  /* hero background loop: play only the variant for the current theme; never with reduced motion */
  var heroVideos = Array.prototype.slice.call(document.querySelectorAll("[data-hero-video]"));
  if (heroVideos.length && !reduced && window.matchMedia("(min-width: 561px)").matches){
    var pickVideo = function(){
      heroVideos.forEach(function(v){
        if (getComputedStyle(v).display === "none"){ v.pause(); return; }
        if (v.preload !== "auto"){ v.preload = "auto"; v.load(); }
        var p = v.play(); if (p && p.catch) p.catch(function(){});
      });
    };
    pickVideo();
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", pickVideo);
  }
})();
</script>
<script is:inline>
/* 登录后右上角把「登录/注册」换成头像：控制台（api.bioseeki.com）登录时会把 bs_name
   写到 .bioseeki.com 域名下的 cookie，官网读到就替换。这两个 cookie **只用于显示**，
   不含任何凭证 —— 就算被伪造，也只是显示一个空头像，看不到任何账户数据。 */
(function () {
  var login = document.getElementById("navLogin"), signup = document.getElementById("navSignup");
  var account = document.getElementById("navAccount"), user = document.getElementById("navUser");
  var menu = document.getElementById("navAccountMenu"), avatar = document.getElementById("navAvatar"), uname = document.getElementById("navUname");
  if (!account || !user || !menu || !avatar) return;
  function close(focus) { menu.hidden = true; user.setAttribute("aria-expanded", "false"); if (focus) user.focus(); }
  function sync() {
    var m = document.cookie.match(/(?:^|;\s*)bs_name=([^;]*)/), name = "";
    try { name = m ? decodeURIComponent(m[1]).trim() : ""; } catch (_) {}
    account.hidden = !name; if (login) login.hidden = !!name; if (signup) signup.hidden = !!name;
    avatar.textContent = (Array.from(name)[0] || "·").toUpperCase(); if (uname) uname.textContent = name;
    if (!name) close(false);
  }
  user.addEventListener("click", function () { var open = menu.hidden; menu.hidden = !open; user.setAttribute("aria-expanded", String(open)); });
  user.addEventListener("keydown", function (e) { if (e.key === "ArrowDown" || e.key === "ArrowUp") { e.preventDefault(); menu.hidden = false; user.setAttribute("aria-expanded", "true"); var items = menu.querySelectorAll("a"); items[e.key === "ArrowDown" ? 0 : items.length - 1].focus(); } });
  menu.addEventListener("keydown", function (e) { var items = Array.from(menu.querySelectorAll("a")), i = items.indexOf(document.activeElement), target;
    if (e.key === "ArrowDown") target = items[(i + 1) % items.length];
    if (e.key === "ArrowUp") target = items[(i + items.length - 1) % items.length];
    if (e.key === "Home") target = items[0]; if (e.key === "End") target = items[items.length - 1];
    if (target) { e.preventDefault(); target.focus(); }
  });
  document.addEventListener("click", function (e) { if (!account.contains(e.target)) close(false); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !menu.hidden) { e.preventDefault(); close(true); } });
  account.addEventListener("focusout", function (e) { if (!account.contains(e.relatedTarget)) close(false); });
  window.addEventListener("pageshow", sync); window.addEventListener("focus", sync); sync();
})();
</script>
