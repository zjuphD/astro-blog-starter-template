---
// BioSeeki homepage template. All copy lives in src/i18n/bioseeki.ts; this file only
// arranges it. Rendered by pages/bioseeki-home.astro (auto language) and pages/en.astro.
//
// Visual language: the TRACE film's "proof sheet in two inks" (bioseeki-promo/src/trace/theme.ts):
// warm paper and near-black ink, a heavy serif for statements, hairline rules instead of boxes,
// sage for what is verified, ochre for evidence locators, the editor's red for what is wrong.
// Screens and documents sit on the paper as sheets; nothing else gets a card.
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource/instrument-sans/400.css";
import "@fontsource/instrument-sans/500.css";
import "@fontsource/instrument-sans/600.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../../styles/display-font.css";
import Label from "./Label.astro";
import { COPY, type Lang } from "../../i18n/bioseeki";
import { SAME_AS, VERIFY } from "../../seo";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = COPY[lang];
// 下载按钮指向的安装包地址。留空 = 按钮显示「即将上线」且不可点（安装包还没上传）；
// 等签名 + 公证好的 DMG 传到 R2 后，把地址填在这里即可（例：
// https://dl.bioseeki.com/mac/Bioseeki-0.1.0-arm64.dmg），其它地方都不用改。
const MAC_DMG_URL = "";
// 首屏 / 导航 / 下载区的「下载」按钮共用这一个开关：有地址就直接下载，没有就跳到下载区（那里如实说明状态并提供邮件获取）。
const dlHref = MAC_DMG_URL || "#download";
const dlAttr = MAC_DMG_URL ? "" : undefined;
const mailto = `mailto:${t.links.mail}?subject=${encodeURIComponent(t.download.mailSubject)}&body=${encodeURIComponent(t.download.mailBody)}`;
// 定价卡上的额度条按各档 credits 占最大档的比例画。
const creditsOf = (c) => Number(String(c).replace(/,/g, ""));
const maxCredits = Math.max(...t.pricing.plans.map((p) => creditsOf(p.credits)));
// Headline: the part of the second line that gets the sage underline, as in the film's last card.
const markAt = t.hero.h1b.indexOf(t.hero.h1mark);
const h1pre = markAt < 0 ? t.hero.h1b : t.hero.h1b.slice(0, markAt);
const h1post = markAt < 0 ? "" : t.hero.h1b.slice(markAt + t.hero.h1mark.length);
const stop = lang === "zh" ? "。" : ".";
const nn = (n) => String(n).padStart(2, "0");
const SECTIONS = 8;
const page = (n) => `${nn(n)} / ${nn(SECTIONS)}`;

const ORG = "https://bioseeki.com/#organization";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": ORG,
    name: "BioSeeki",
    url: "https://bioseeki.com/",
    logo: "https://bioseeki.com/bioseeki/mark.webp",
    email: t.links.mail,
    ...(SAME_AS.length ? { sameAs: SAME_AS } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://bioseeki.com/#website",
    name: "BioSeeki",
    url: "https://bioseeki.com/",
    inLanguage: ["zh-CN", "en"],
    publisher: { "@id": ORG },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    publisher: { "@id": ORG },
    name: "BioSeeki",
    applicationCategory: "ScienceApplication",
    operatingSystem: "macOS 11+ (Apple silicon)",
    description: t.jsonLdDescription,
    url: t.canonical,
    image: "https://bioseeki.com/bioseeki/demo-poster.jpg",
    inLanguage: t.htmlLang,
    ...(MAC_DMG_URL ? { downloadUrl: MAC_DMG_URL } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: t.faq.items.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script is:inline>document.documentElement.classList.add("js");</script>
<title>{t.title}</title>
<meta name="description" content={t.description}>
<meta name="theme-color" content="#F1EFE8" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0F1311" media="(prefers-color-scheme: dark)">
<meta property="og:title" content={t.ogTitle}>
<meta property="og:description" content={t.ogDescription}>
<meta property="og:type" content="website">
<meta property="og:url" content={t.canonical}>
<meta property="og:locale" content={t.ogLocale}>
<meta property="og:image" content="https://bioseeki.com/bioseeki/demo-poster.jpg">
<meta property="og:image:width" content="1920">
<meta property="og:image:height" content="1080">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={t.title}>
<meta name="twitter:description" content={t.twitterDescription}>
<meta name="twitter:image" content="https://bioseeki.com/bioseeki/demo-poster.jpg">
<link rel="canonical" href={t.canonical}>
<link rel="alternate" hreflang="zh-CN" href="https://bioseeki.com/">
<link rel="alternate" hreflang="en" href="https://bioseeki.com/en">
<link rel="alternate" hreflang="x-default" href="https://bioseeki.com/">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png">
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
{lang === "zh" && <link rel="preload" href="/fonts/noto-serif-sc-900-display.woff2" as="font" type="font/woff2" crossorigin>}
<meta name="robots" content="index,follow,max-image-preview:large">
{VERIFY.google && <meta name="google-site-verification" content={VERIFY.google}>}
{VERIFY.bing && <meta name="msvalidate.01" content={VERIFY.bing}>}
{VERIFY.baidu && <meta name="baidu-site-verification" content={VERIFY.baidu}>}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<style is:global>
/* ============ TOKENS ============ */
:root{
  --paper:#F1EFE8;           /* ground: the film's proof paper, a hair lighter for screens */
  --paper-2:#E7E4DB;         /* figure plates */
  --sheet:#FBFAF6;           /* documents and screens laid on the paper */
  --ink:#0E1210;             /* statements */
  --text:#2A302C;            /* body */
  --muted:#5D6862;           /* secondary text, 5:1 on paper */
  --rule:rgba(14,18,16,.12);
  --rule-2:rgba(14,18,16,.26);
  --sage:#557A64;            /* verified */
  --sage-text:#40664F;
  --ochre:#C08A2D;           /* evidence, locators, gaps */
  --ochre-text:#8C5F12;
  --hilite:rgba(236,188,72,.42);
  --red:#C23B24;             /* the editor's pen: wrong */
  --btn:#0E1210;
  --btn-text:#F1EFE8;
  --band:#0E1210;            /* the one dark band (demo) */
  --shadow:0 1px 2px rgba(14,18,16,.05), 0 28px 56px -34px rgba(14,18,16,.34);
  --font-sans:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans SC","Noto Sans CJK SC",system-ui,-apple-system,"Segoe UI",sans-serif;
  /* headline face: Noto Serif SC Black cut to the display copy (scripts/display-font.mjs); Songti is the fallback */
  --font-display:"BioSeeki Display","Songti SC","STSong","Noto Serif CJK SC","Source Han Serif SC",serif;
  --font-mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  --font-label:"IBM Plex Mono","PingFang SC","Microsoft YaHei","Noto Sans SC",monospace;
  --font-brand:"Plus Jakarta Sans Variable","Plus Jakarta Sans",system-ui,sans-serif;
  --display-weight:900;
  color-scheme:light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#0F1311; --paper-2:#171C19; --sheet:#161B18;
    --ink:#F1EFE8; --text:#D5D9D2; --muted:#9AA49E;
    --rule:rgba(241,239,232,.11); --rule-2:rgba(241,239,232,.24);
    --sage:#8FB49F; --sage-text:#9CC3AC;
    --ochre:#D9A94E; --ochre-text:#DDB066; --hilite:rgba(217,169,78,.30);
    --red:#F0603F;
    --btn:#F1EFE8; --btn-text:#0E1210;
    --band:#080A09;
    --shadow:0 1px 2px rgba(0,0,0,.35), 0 28px 56px -30px rgba(0,0,0,.75);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --paper:#0F1311; --paper-2:#171C19; --sheet:#161B18;
  --ink:#F1EFE8; --text:#D5D9D2; --muted:#9AA49E;
  --rule:rgba(241,239,232,.11); --rule-2:rgba(241,239,232,.24);
  --sage:#8FB49F; --sage-text:#9CC3AC;
  --ochre:#D9A94E; --ochre-text:#DDB066; --hilite:rgba(217,169,78,.30);
  --red:#F0603F;
  --btn:#F1EFE8; --btn-text:#0E1210;
  --band:#080A09;
  --shadow:0 1px 2px rgba(0,0,0,.35), 0 28px 56px -30px rgba(0,0,0,.75);
  color-scheme:dark;
}
body[data-lang="en"]{
  --font-sans:"Instrument Sans","PingFang SC",system-ui,-apple-system,"Segoe UI",sans-serif;
  --font-display:"Instrument Serif","BioSeeki Display","Songti SC",Georgia,serif;
  --display-weight:400;
}

/* ============ BASE ============ */
*,*::before,*::after{ box-sizing:border-box; margin:0; padding:0; }
html{ scroll-behavior:smooth; scroll-padding-top:84px; -webkit-text-size-adjust:100%; }
body{
  background:var(--paper); color:var(--text);
  font-family:var(--font-sans); font-size:16px; line-height:1.75;
  -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
  overflow-x:hidden;
}
body[data-lang="en"]{ line-height:1.62; }
::selection{ background:var(--hilite); color:var(--ink); }
a{ color:inherit; text-decoration:none; }
img,video{ display:block; max-width:100%; }
ul,ol{ list-style:none; }
p{ text-wrap:pretty; }
button{ font:inherit; color:inherit; }
/* CJK headings break at punctuation, not mid-word; anywhere only as a last resort */
h1,h2,h3,h4,.foot-tag{ word-break:keep-all; overflow-wrap:anywhere; }
:focus-visible{ outline:2px solid var(--sage); outline-offset:3px; border-radius:4px; }
.wrap{ width:min(1200px,calc(100% - 64px)); margin-inline:auto; }

/* ============ SHARED BITS ============ */
.label{ font-family:var(--font-label); font-size:11.5px; line-height:1.5; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
.label-ochre{ color:var(--ochre-text); }
.loc{ font-family:var(--font-label); font-size:12px; letter-spacing:.01em; color:var(--ochre-text); overflow-wrap:anywhere; }
.mono-tags{ font-family:var(--font-label); font-size:12px; line-height:1.7; letter-spacing:.01em; color:var(--muted); }
.tag{ display:inline-flex; align-items:center; gap:6px; font-size:12px; line-height:1; padding:5px 8px; border:1px solid var(--rule-2); border-radius:4px; color:var(--muted); white-space:nowrap; }
.tag-ink{ background:var(--ink); border-color:var(--ink); color:var(--paper); }
.dot{ width:6px; height:6px; border-radius:50%; background:var(--sage); flex:none; }
.dot-live{ background:var(--ochre); animation:pulse 2.4s ease-in-out infinite; }
@keyframes pulse{ 0%,100%{ opacity:1; } 50%{ opacity:.3; } }
.link{ display:inline-flex; align-items:center; font-weight:600; color:var(--ink); text-decoration:underline; text-decoration-color:var(--rule-2); text-decoration-thickness:1px; text-underline-offset:5px; transition:text-decoration-color .2s ease; }
.link:hover{ text-decoration-color:currentColor; }
.ai{ display:inline-block; width:.92em; height:.92em; margin-left:.32em; vertical-align:-.1em; flex:none; fill:none; stroke:currentColor; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; }
.bi{ width:16px; height:16px; flex:none; fill:none; stroke:currentColor; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; }
.ico{ display:block; width:22px; height:22px; fill:none; stroke:var(--sage); stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
.ck{ width:16px; height:16px; flex:none; fill:none; stroke:var(--sage); stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
.nowrap{ white-space:nowrap; }
.num{ font-family:var(--font-mono); font-size:12px; color:var(--muted); font-variant-numeric:tabular-nums; }

.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:9px;
  height:44px; padding:0 18px; border-radius:6px; border:1px solid transparent;
  font-size:15px; font-weight:600; line-height:1; white-space:nowrap; cursor:pointer;
  transition:background-color .2s ease, border-color .2s ease, color .2s ease;
}
.btn .ai{ margin-left:0; }
.btn-lg{ height:50px; padding:0 22px; font-size:15.5px; }
.btn-sm{ height:36px; padding:0 13px; font-size:13.5px; gap:7px; }
.btn-ink{ background:var(--btn); color:var(--btn-text); }
.btn-ink:hover{ background:color-mix(in srgb, var(--btn) 82%, var(--sage)); }
.btn-line{ border-color:var(--rule-2); color:var(--ink); }
.btn-line:hover{ border-color:var(--ink); }

/* ============ NAV ============ */
.nav{ position:fixed; inset:0 0 auto; z-index:50; height:64px; border-bottom:1px solid transparent; transition:background-color .3s ease, border-color .3s ease; }
.nav.scrolled{
  background:color-mix(in srgb, var(--paper) 86%, transparent);
  -webkit-backdrop-filter:saturate(1.4) blur(16px); backdrop-filter:saturate(1.4) blur(16px);
  border-bottom-color:var(--rule);
}
.nav-in{ height:100%; display:flex; align-items:center; gap:32px; }
.brand{ display:inline-flex; align-items:center; gap:9px; color:var(--ink); margin-right:auto; }
.brand-mark{ width:24px; height:24px; object-fit:contain; }
.brand-name{ font-family:var(--font-brand); font-weight:600; font-size:18px; letter-spacing:-.015em; }
.nav-links{ display:flex; gap:24px; }
.nav-links a,.nav-text{ font-size:14px; color:var(--muted); white-space:nowrap; transition:color .2s ease; }
.nav-links a:hover,.nav-links a[aria-current="true"],.nav-text:hover{ color:var(--ink); }
.nav-actions{ display:flex; align-items:center; gap:16px; flex:none; }
.lang-switch{ font-family:var(--font-label); font-size:12px; letter-spacing:.06em; }

/* ============ SECTIONS ============ */
section{ padding-top:clamp(88px,10vw,148px); }
/* running head: every section opens like a page of the proof */
.rh{ display:flex; flex-wrap:wrap; justify-content:space-between; gap:4px 24px; padding-top:12px; border-top:1px solid var(--rule-2); font-family:var(--font-label); font-size:11.5px; line-height:1.6; letter-spacing:.08em; color:var(--muted); }
.rh > :first-child{ color:var(--ink); }
.sh{ display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:24px; align-items:end; margin:clamp(36px,5vw,64px) 0 clamp(56px,7vw,96px); }
.sh-title{
  grid-column:1 / span 7;
  font-family:var(--font-display); font-weight:var(--display-weight);
  font-size:clamp(32px,4vw,56px); line-height:1.18; letter-spacing:-.01em;
  color:var(--ink); text-wrap:balance; font-feature-settings:"palt";
}
body[data-lang="en"] .sh-title{ font-size:clamp(40px,5vw,72px); line-height:1.02; letter-spacing:-.015em; }
.sh-lede{ grid-column:9 / span 4; font-size:16px; line-height:1.8; color:var(--muted); }
body[data-lang="en"] .sh-lede{ line-height:1.62; }
.sh-lede a{ color:var(--ink); font-weight:600; text-decoration:underline; text-decoration-color:var(--rule-2); text-underline-offset:4px; }
.sh-lede a:hover{ text-decoration-color:currentColor; }

/* ============ REVEAL ============ */
.js .rv{ opacity:0; transform:translateY(14px); transition:opacity .9s cubic-bezier(.16,1,.3,1) var(--d,0s), transform .9s cubic-bezier(.16,1,.3,1) var(--d,0s); }
.js .rv.in{ opacity:1; transform:none; }

/* ============ HERO ============ */
.hero{ padding-top:clamp(104px,15vh,148px); }
.hero-h1{
  margin:clamp(40px,7vh,80px) 0 clamp(40px,6vh,64px);
  font-family:var(--font-display); font-weight:var(--display-weight);
  font-size:clamp(38px,6.6vw,100px); line-height:1.12; letter-spacing:-.012em;
  color:var(--ink); font-feature-settings:"palt";
}
body[data-lang="en"] .hero-h1{ font-size:clamp(48px,7.8vw,124px); line-height:.98; letter-spacing:-.02em; }
/* masked lines: each line rises out of its own slot, as the film sets type */
.ln{ display:block; overflow:hidden; padding:.06em 0 .16em; margin:-.06em 0 -.16em; }
.ln > span{ display:inline-block; }
.js .ln > span{ transform:translateY(112%); transition:transform 1.2s cubic-bezier(.16,1,.3,1) var(--d,0s); }
.js .hero.in .ln > span{ transform:none; }
.mark{ background:linear-gradient(var(--sage),var(--sage)) 0 100% / 100% .07em no-repeat; -webkit-box-decoration-break:clone; box-decoration-break:clone; }
.js .mark{ background-size:0% .07em; transition:background-size 1s cubic-bezier(.65,0,.35,1) 1.05s; }
.js .hero.in .mark{ background-size:100% .07em; }
.h1-check{ display:inline-block; width:.5em; height:.5em; margin-left:.12em; vertical-align:0; fill:none; stroke:var(--sage); stroke-width:5.5; stroke-linecap:round; stroke-linejoin:round; stroke-dasharray:64; stroke-dashoffset:0; }
.js .h1-check{ stroke-dashoffset:64; transition:stroke-dashoffset .6s cubic-bezier(.65,0,.35,1) 1.85s; }
.js .hero.in .h1-check{ stroke-dashoffset:0; }
.hero-row{ display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:24px; align-items:start; }
.hero-copy{ grid-column:1 / span 5; }
.hero-sub{ font-size:18px; line-height:1.85; color:var(--text); }
body[data-lang="en"] .hero-sub{ font-size:19px; line-height:1.58; }
.hero-sub strong{ font-weight:600; color:var(--ink); background:linear-gradient(transparent 60%, var(--hilite) 60%, var(--hilite) 94%, transparent 94%); }
.hero-ctas{ display:flex; flex-wrap:wrap; gap:12px; margin-top:36px; }
.hero-meta{ margin-top:22px; font-size:14px; }

/* hero sheet: an illustrative research session */
.sheet{ background:var(--sheet); border:1px solid var(--rule); border-radius:10px; box-shadow:var(--shadow); }
.sess{ grid-column:7 / span 6; overflow:hidden; }
.sess-head{ display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 20px; border-bottom:1px solid var(--rule); }
.sess-q{ display:flex; gap:12px; align-items:flex-start; padding:18px 20px; border-bottom:1px solid var(--rule); }
.sess-q p{ font-size:16px; line-height:1.65; font-weight:500; color:var(--ink); }
.who{ flex:none; margin-top:4px; font-family:var(--font-label); font-size:11px; line-height:1; padding:4px 6px; border-radius:3px; background:var(--ink); color:var(--paper); }
.sess-rows li{ display:grid; grid-template-columns:24px minmax(0,1fr) auto; align-items:center; gap:14px; padding:13px 20px; border-bottom:1px solid var(--rule); }
.js .sess-rows li{ opacity:.26; transition:opacity .5s ease; }
.js .sess-rows li.on{ opacity:1; }
.sess-tool{ display:block; font-family:var(--font-label); font-size:11.5px; letter-spacing:.02em; color:var(--muted); }
.sess-msg{ display:block; font-size:14.5px; line-height:1.55; color:var(--ink); }
.stamp{ font-family:var(--font-label); font-size:11.5px; line-height:1; padding:5px 7px; border:1px solid currentColor; border-radius:4px; white-space:nowrap; }
.js .sess-rows .stamp{ opacity:0; transition:opacity .4s ease .25s; }
.js .sess-rows li.on .stamp{ opacity:1; }
.st-ok{ color:var(--sage-text); }
.st-warn{ color:var(--ochre-text); }
.sess-foot{ display:flex; flex-wrap:wrap; justify-content:space-between; gap:6px 16px; padding:13px 20px; font-size:12.5px; color:var(--muted); }
.sess-foot b{ font-family:var(--font-mono); font-weight:500; color:var(--ink); }

/* the four promises, as a ruled strip */
.proofs{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); margin-top:clamp(72px,10vh,112px); border-top:1px solid var(--rule-2); border-bottom:1px solid var(--rule); }
.proofs li{ display:flex; align-items:center; gap:10px; padding:20px 16px 20px 0; font-size:15px; font-weight:500; line-height:1.45; color:var(--ink); }
.proofs li + li{ padding-left:20px; border-left:1px solid var(--rule); }

/* ============ FIGURES ============ */
.win{ position:relative; border:1px solid var(--rule-2); border-radius:12px; overflow:hidden; background:var(--sheet); box-shadow:var(--shadow); }
.win-bar{ display:flex; align-items:center; gap:7px; height:38px; padding:0 16px; border-bottom:1px solid var(--rule); }
.win-bar > i{ width:10px; height:10px; border-radius:50%; background:var(--rule-2); }
.win-title{ margin-left:12px; font-family:var(--font-label); font-size:11px; letter-spacing:.08em; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.win-badge{ margin-left:auto; display:inline-flex; align-items:center; gap:7px; font-size:12px; color:var(--sage-text); white-space:nowrap; }
.fig figcaption{ display:flex; flex-wrap:wrap; align-items:baseline; gap:4px 14px; margin-top:16px; font-size:13.5px; line-height:1.65; color:var(--muted); }
.fig figcaption b{ font-family:var(--font-label); font-size:11.5px; font-weight:500; letter-spacing:.08em; color:var(--ink); }
.cap-note{ flex-basis:100%; }
.shot{ position:relative; display:block; width:100%; padding:0; border:0; background:#fff; text-align:left; cursor:zoom-in; }
.shot img{ width:100%; height:auto; }
.shot:focus-visible{ outline-offset:-3px; }
.shot-hint{
  position:absolute; right:14px; bottom:14px; z-index:2;
  display:inline-flex; align-items:center; gap:6px;
  font-size:12px; line-height:1; padding:7px 10px; border-radius:5px;
  color:#F1EFE8; background:rgba(14,18,16,.8);
  opacity:0; transform:translateY(4px); transition:opacity .2s ease, transform .2s ease;
}
.shot:hover .shot-hint,.shot:focus-visible .shot-hint{ opacity:1; transform:none; }
@media (hover:none){ .shot-hint{ opacity:.92; transform:none; } }

.zoom{ position:fixed; inset:0; width:100vw; height:100dvh; max-width:none; max-height:none; margin:0; padding:0; border:0; background:transparent; color:#F1EFE8; }
.zoom[open]{ display:flex; flex-direction:column; }
.zoom::backdrop{ background:rgba(8,10,9,.86); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px); }
.zoom-top{ display:flex; align-items:center; justify-content:space-between; gap:16px; padding:14px 18px 10px 22px; }
.zoom-cap{ font-size:14px; color:rgba(241,239,232,.88); }
.zoom-close{ flex:none; width:40px; height:40px; border-radius:50%; border:1px solid rgba(241,239,232,.28); background:rgba(241,239,232,.08); cursor:pointer; display:grid; place-items:center; }
.zoom-close:hover{ background:rgba(241,239,232,.18); }
.zoom-stage{ flex:1; min-height:0; overflow:auto; display:grid; place-items:center; padding:4px 22px; overscroll-behavior:contain; }
.zoom-stage img{ max-width:100%; max-height:100%; width:auto; height:auto; border-radius:8px; box-shadow:0 24px 70px rgba(0,0,0,.5); }
@media (hover:hover) and (pointer:fine){ .zoom-stage img{ cursor:zoom-out; } }
.zoom-tip{ text-align:center; font-size:12px; color:rgba(241,239,232,.6); padding:8px 0 14px; }
.zoom-tip .t-touch{ display:none; }
html:has(.zoom[open]){ overflow:hidden; }

/* ============ 01 CAPABILITIES ============ */
.feature-head{ display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:24px; align-items:end; margin-bottom:32px; }
.feature-text{ grid-column:1 / span 7; }
.feature-side{ grid-column:9 / span 4; display:flex; flex-direction:column; align-items:flex-start; gap:18px; }
.kicker{ display:flex; align-items:center; gap:14px; margin-bottom:14px; }
.status{ display:inline-flex; align-items:center; gap:7px; font-size:12.5px; color:var(--sage-text); }
.feature-title{ font-family:var(--font-display); font-weight:var(--display-weight); font-size:clamp(26px,2.6vw,36px); line-height:1.2; color:var(--ink); margin-bottom:14px; font-feature-settings:"palt"; }
body[data-lang="en"] .feature-title{ font-size:clamp(34px,3.4vw,48px); line-height:1.02; }
.feature-p{ font-size:16px; color:var(--muted); max-width:36em; }
.plain-tags{ display:flex; flex-wrap:wrap; gap:6px; }
.plain-tags li{ font-size:13px; line-height:1.3; padding:6px 10px; border:1px solid var(--rule-2); border-radius:4px; color:var(--text); }

.modes{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); margin-top:clamp(80px,9vw,128px); border-top:1px solid var(--rule-2); }
.mode{ display:flex; flex-direction:column; padding:26px 24px 0; }
.mode:first-child{ padding-left:0; }
.mode:last-child{ padding-right:0; }
.mode + .mode{ border-left:1px solid var(--rule); }
.mode-top{ display:flex; justify-content:space-between; align-items:center; margin-bottom:30px; }
.mode h3{ font-size:20px; font-weight:600; line-height:1.35; color:var(--ink); margin-bottom:10px; }
.mode-p{ font-size:14.5px; line-height:1.75; color:var(--muted); }
.io{ margin-top:22px; border-top:1px solid var(--rule); }
.io > div{ padding:12px 0; border-bottom:1px solid var(--rule); }
.io dt{ font-family:var(--font-label); font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); margin-bottom:3px; }
.io dd{ font-size:14.5px; line-height:1.55; color:var(--text); text-wrap:pretty; }
.io-out dt{ color:var(--ochre-text); }
.io-out dd{ color:var(--ink); font-weight:600; }
.mode .mono-tags{ margin-top:14px; }

.catalog{ margin-top:clamp(80px,9vw,128px); }
.catalog-head{ display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:8px 24px; padding-bottom:16px; border-bottom:1px solid var(--rule-2); }
.catalog-head h3{ font-size:20px; font-weight:600; color:var(--ink); }
.catalog-head p{ font-size:14px; color:var(--muted); }
.catalog-grid{ display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); column-gap:24px; }
.catalog-col{ padding-top:24px; }
.catalog-col h4{ font-size:16px; font-weight:600; color:var(--ink); margin:6px 0 10px; }
.catalog-col li{ font-size:14px; line-height:2; color:var(--muted); }

/* ============ 02 VERIFIABLE ============ */
.verify{ display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:24px; align-items:start; }
.vcards{ grid-column:1 / span 6; display:grid; grid-template-columns:1fr 1fr; column-gap:32px; }
.vcard{ border-top:1px solid var(--rule-2); padding:26px 0 44px; }
.vcard h3{ font-size:19px; font-weight:600; color:var(--ink); margin:18px 0 8px; }
.vcard p{ font-size:14.5px; line-height:1.75; color:var(--muted); }
.vcard .loc{ display:inline-block; margin-top:14px; }
.report{ grid-column:8 / span 5; overflow:hidden; position:sticky; top:96px; }
.report-bar{ display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 20px; border-bottom:1px solid var(--rule); }
.cmd{ font-family:var(--font-mono); font-size:13px; color:var(--ink); }
.cmd::before{ content:"$ "; color:var(--muted); }
.rrow{ display:grid; grid-template-columns:auto minmax(0,1fr); gap:14px; align-items:baseline; padding:15px 20px; border-bottom:1px solid var(--rule); }
.verdict{ font-family:var(--font-label); font-size:11.5px; line-height:1; padding:5px 7px; border:1px solid currentColor; border-radius:4px; min-width:6.4em; text-align:center; white-space:nowrap; }
.v-pass{ color:var(--sage-text); }
.v-warn{ color:var(--ochre-text); }
.v-fail{ color:var(--red); }
.v-unk{ color:var(--muted); }
.rtext{ font-size:14.5px; line-height:1.6; color:var(--text); }
.rtext small{ font-family:var(--font-mono); font-size:11.5px; color:var(--muted); margin-right:8px; }
.report-foot{ display:flex; flex-wrap:wrap; justify-content:space-between; gap:6px 16px; padding:13px 20px; font-size:12.5px; color:var(--muted); }

/* ============ 03 KNOWLEDGE & MEMORY ============ */
.chain-plate{ position:relative; background:var(--paper-2); border-radius:12px; padding:clamp(20px,3.2vw,44px); }
.chain-grid{ position:relative; display:grid; grid-template-columns:.8fr 1fr 1.25fr; gap:clamp(40px,6vw,96px); }
.chain-wires{ position:absolute; inset:0; width:100%; height:100%; pointer-events:none; overflow:visible; z-index:0; }
.wire{ fill:none; stroke-width:1.2; stroke:color-mix(in srgb, var(--sage) 75%, transparent); }
.wire-end{ fill:var(--sage); }
.chain-col{ position:relative; z-index:1; min-width:0; }
.chain-h{ font-family:var(--font-label); font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); margin-bottom:12px; }
.chain-sources{ display:grid; gap:8px; }
.chain-sources li{ font-size:14px; line-height:1.4; padding:9px 12px; border-radius:6px; background:var(--sheet); border:1px solid var(--rule); color:var(--ink); }
.chain-sources li:last-child{ border-style:dashed; border-color:var(--rule-2); background:transparent; }
.chain-core{ display:grid; gap:8px; padding:10px; border-radius:10px; background:var(--sheet); border:1px solid color-mix(in srgb, var(--sage) 60%, transparent); }
.frag{ display:grid; gap:2px; padding:10px 12px; border-radius:6px; background:color-mix(in srgb, var(--paper-2) 50%, var(--sheet)); }
.frag-file{ font-family:var(--font-mono); font-size:12.5px; color:var(--ink); overflow-wrap:anywhere; }
.frag-loc{ font-size:12.5px; font-weight:600; color:var(--ochre-text); }
.frag-note{ font-family:var(--font-label); font-size:11px; color:var(--muted); padding:2px 4px 0; }
.chain-draft{ display:grid; gap:12px; padding:22px 24px; border-radius:8px; background:var(--sheet); box-shadow:var(--shadow); }
.claim{ font-size:14.5px; line-height:1.65; color:var(--ink); }
.claim-ref{ margin-left:6px; font-family:var(--font-mono); font-size:11.5px; color:var(--ochre-text); background:var(--hilite); padding:1px 5px; border-radius:3px; white-space:nowrap; }
.claim-gap{ font-family:var(--font-label); font-size:12.5px; color:var(--ochre-text); border:1px dashed color-mix(in srgb, var(--ochre) 75%, transparent); border-radius:4px; padding:6px 10px; }

.principles{ display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); column-gap:32px; margin-top:clamp(72px,8vw,112px); }
.principle{ border-top:1px solid var(--rule-2); padding-top:24px; }
.principle h3{ font-size:20px; font-weight:600; color:var(--ink); margin:14px 0 8px; }
.principle-p{ font-size:15px; color:var(--muted); }

.fig-side{ display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:24px; align-items:end; margin-top:clamp(72px,8vw,112px); }
.fig-side .win{ grid-column:4 / span 9; grid-row:1; }
.fig-side figcaption{ grid-column:1 / span 3; grid-row:1; flex-direction:column; align-items:flex-start; gap:10px; margin:0; padding-bottom:4px; }
.fig-side .cap-note{ flex-basis:auto; }
.shot-pad{ padding:clamp(12px,2.2vw,28px); background:var(--paper-2); }
.shot-pad img{ border-radius:6px; box-shadow:0 1px 2px rgba(14,18,16,.08); }

/* ============ 04 A PROJECT ============ */
.case{ display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:24px; align-items:start; }
.case-card{ grid-column:1 / span 4; position:sticky; top:96px; border-top:1px solid var(--rule-2); padding-top:24px; }
.case-q{ font-size:21px; line-height:1.55; font-weight:600; color:var(--ink); margin:12px 0 22px; }
.case-meta{ border-top:1px solid var(--rule); }
.case-meta div{ display:grid; grid-template-columns:6.5em minmax(0,1fr); gap:10px; padding:10px 0; border-bottom:1px solid var(--rule); font-size:13.5px; }
.case-meta dt{ color:var(--muted); }
.case-meta dd{ font-family:var(--font-label); font-size:12.5px; color:var(--ink); overflow-wrap:anywhere; }
.case-stats{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); margin-top:26px; }
.case-stats b{ display:block; font-family:var(--font-display); font-weight:var(--display-weight); font-size:44px; line-height:1; color:var(--ink); }
body[data-lang="en"] .case-stats b{ font-size:56px; }
.case-stats span{ display:block; margin-top:8px; font-size:12.5px; color:var(--muted); }
.case-stats .is-gap b{ color:var(--ochre-text); }
.case-note{ margin-top:22px; font-size:12.5px; line-height:1.7; color:var(--muted); }
.log{ grid-column:6 / span 7; border-top:1px solid var(--rule-2); }
.log-step{ display:grid; grid-template-columns:56px minmax(0,1fr); padding:26px 0 28px; border-bottom:1px solid var(--rule); }
.log-step .num{ padding-top:5px; }
.log-step h3{ font-size:19px; font-weight:600; color:var(--ink); margin-bottom:12px; }
.log-dl > div{ display:grid; grid-template-columns:4.8em minmax(0,1fr); gap:12px; padding:3px 0; font-size:14.5px; line-height:1.7; }
body[data-lang="en"] .log-dl > div{ grid-template-columns:5.8em minmax(0,1fr); }
.log-dl dt{ font-family:var(--font-label); font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--muted); padding-top:4px; }
.log-dl dd{ color:var(--text); text-wrap:pretty; }
.confirm{ margin-top:14px; padding:10px 14px; border-left:2px solid var(--ochre); background:color-mix(in srgb, var(--ochre) 9%, transparent); font-size:14px; color:var(--ink); }
.confirm span{ font-family:var(--font-label); font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--ochre-text); margin-right:10px; }
.fig-wide{ margin-top:clamp(72px,8vw,112px); }
.bounds{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); column-gap:24px; margin-top:clamp(72px,8vw,112px); }
.bound{ border-top:1px solid var(--rule-2); padding-top:22px; }
.bound h3{ font-size:16px; font-weight:600; line-height:1.45; color:var(--ink); margin:14px 0 6px; }
.bound p{ font-size:14px; line-height:1.7; color:var(--muted); }

/* ============ 05 DEMO: the one dark band ============ */
.band{
  background:var(--band); color:#D5D9D2;
  margin-top:clamp(88px,10vw,148px); padding-bottom:clamp(88px,10vw,136px);
  --ink:#F1EFE8; --text:#D5D9D2; --muted:#9AA49E;
  --rule:rgba(241,239,232,.12); --rule-2:rgba(241,239,232,.26);
  --sage:#8FB49F; --sage-text:#9CC3AC; --ochre-text:#DDB066;
}
.film{ border:1px solid var(--rule-2); border-radius:12px; overflow:hidden; background:#000; }
.film video{ width:100%; aspect-ratio:16/9; background:#000; }
.film-foot{ display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:10px 24px; margin-top:16px; font-size:13.5px; color:var(--muted); }
.film-foot .label{ color:var(--ink); margin-right:14px; }

/* ============ 06 DOWNLOAD & START ============ */
.get{ display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:24px; align-items:start; }
.dl{ grid-column:1 / span 6; display:flex; flex-direction:column; gap:22px; padding:clamp(24px,3vw,36px); }
.dl-top{ display:flex; align-items:center; gap:14px; }
.dl-mark{ width:30px; height:30px; object-fit:contain; flex:none; }
.dl-app{ margin-right:auto; font-family:var(--font-brand); font-size:22px; font-weight:600; letter-spacing:-.015em; line-height:1.3; color:var(--ink); }
.specs{ border-top:1px solid var(--rule); }
.specs > div{ display:grid; grid-template-columns:6.5em minmax(0,1fr); gap:12px; padding:12px 0; border-bottom:1px solid var(--rule); }
.specs dt{ font-family:var(--font-label); font-size:11.5px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); padding-top:3px; }
.specs dd{ font-size:15px; line-height:1.55; color:var(--ink); }
.dl-note{ margin-top:-8px; font-size:13.5px; color:var(--muted); }
.dl-actions{ display:flex; flex-direction:column; align-items:flex-start; gap:14px; }
.dl-soon{ display:flex; align-items:center; gap:10px; font-size:14.5px; line-height:1.55; color:var(--text); }
.dl-legal{ padding-top:18px; border-top:1px solid var(--rule); font-size:12.5px; line-height:1.75; color:var(--muted); }
.dl-legal a{ color:var(--ink); text-decoration:underline; text-decoration-color:var(--rule-2); text-underline-offset:3px; }
.dl-legal a:hover{ text-decoration-color:currentColor; }
.steps{ grid-column:8 / span 5; }
.steps ol{ margin-top:14px; border-top:1px solid var(--rule-2); }
.step{ display:grid; grid-template-columns:64px minmax(0,1fr); padding:24px 0; border-bottom:1px solid var(--rule); }
.step-n{ font-family:var(--font-display); font-weight:var(--display-weight); font-size:30px; line-height:1.05; color:var(--ink); }
body[data-lang="en"] .step-n{ font-size:40px; line-height:.9; }
.step h3{ font-size:18px; font-weight:600; line-height:1.45; color:var(--ink); margin-bottom:4px; }
.step p{ font-size:14.5px; color:var(--muted); }
.step .btn{ margin-top:14px; }

/* ============ 07 PRICING ============ */
.plans{ display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border-top:1px solid var(--rule-2); }
.plan{ display:flex; flex-direction:column; padding:30px 28px 32px; }
.plan + .plan{ border-left:1px solid var(--rule); }
.plan.hot{ background:var(--sheet); box-shadow:inset 0 2px 0 var(--ink); }
.plan-head{ display:flex; align-items:center; justify-content:space-between; gap:10px; min-height:26px; }
.plan-name{ font-family:var(--font-brand); font-size:17px; font-weight:600; color:var(--ink); }
.plan-price{ display:flex; align-items:baseline; gap:4px; margin:26px 0 20px; color:var(--ink); }
.plan-cur{ align-self:flex-start; margin-top:6px; font-size:20px; font-weight:500; }
.plan-price b{ font-family:var(--font-display); font-weight:var(--display-weight); font-size:clamp(52px,5vw,68px); line-height:.9; letter-spacing:-.02em; font-variant-numeric:lining-nums; }
body[data-lang="en"] .plan-price b{ font-size:clamp(64px,6.4vw,88px); line-height:.8; }
.plan-per{ margin-left:6px; font-size:14px; color:var(--muted); }
.plan-credits{ font-size:14.5px; color:var(--muted); }
.plan-credits b{ font-family:var(--font-mono); font-weight:500; color:var(--ink); }
.meter{ display:block; height:2px; margin:12px 0 18px; background:var(--rule); }
.meter i{ display:block; height:100%; background:var(--sage); }
.plan-sub{ margin-bottom:28px; font-size:14.5px; color:var(--muted); }
.plan-cta{ width:100%; margin-top:auto; }

/* ============ 08 FAQ ============ */
.faq-grid{ display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:24px; align-items:start; margin-top:clamp(36px,5vw,64px); }
.faq-head{ grid-column:1 / span 4; position:sticky; top:96px; }
.faq-head .sh-title{ font-size:clamp(30px,3.2vw,44px); }
body[data-lang="en"] .faq-head .sh-title{ font-size:clamp(40px,4.4vw,60px); }
.faq-head .sh-lede{ margin-top:18px; }
.faq-list{ grid-column:6 / span 7; border-top:1px solid var(--rule-2); }
.faq{ border-bottom:1px solid var(--rule); }
.faq summary{ list-style:none; display:flex; align-items:center; justify-content:space-between; gap:24px; padding:22px 0; cursor:pointer; font-size:17px; font-weight:600; line-height:1.5; color:var(--ink); transition:color .2s ease; }
.faq summary::-webkit-details-marker{ display:none; }
.faq summary:hover{ color:var(--sage-text); }
.pm{ position:relative; width:14px; height:14px; flex:none; }
.pm::before,.pm::after{ content:""; position:absolute; left:0; right:0; top:50%; height:1.5px; margin-top:-.75px; background:currentColor; transition:transform .3s ease; }
.pm::after{ transform:rotate(90deg); }
.faq[open] .pm::after{ transform:rotate(0deg); }
.faq p{ max-width:42em; padding:0 48px 24px 0; font-size:15.5px; line-height:1.8; color:var(--muted); }

/* ============ FOOTER ============ */
.foot{ margin-top:clamp(120px,14vw,200px); padding:clamp(40px,5vw,64px) 0 36px; border-top:1px solid var(--rule-2); }
.foot-tag{ font-family:var(--font-display); font-weight:var(--display-weight); font-size:clamp(44px,8.4vw,128px); line-height:1.08; letter-spacing:-.015em; color:var(--ink); font-feature-settings:"palt"; }
body[data-lang="en"] .foot-tag{ font-size:clamp(54px,9.8vw,150px); line-height:.95; }
.foot-tag em{ font-style:normal; color:var(--sage); }
body[data-lang="en"] .foot-tag em{ font-style:italic; }
.foot-grid{ display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:24px; margin-top:clamp(56px,7vw,96px); padding-top:28px; border-top:1px solid var(--rule); }
.foot-brand{ grid-column:1 / span 4; }
.foot-brand .brand{ margin:0; }
.foot-slogan{ margin-top:12px; font-size:13.5px; color:var(--muted); }
.foot-cols{ grid-column:6 / span 7; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; }
.foot-col-title{ margin-bottom:14px; font-family:var(--font-label); font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
.foot-col ul{ display:grid; gap:8px; }
.foot-col a{ font-size:14px; color:var(--text); overflow-wrap:anywhere; transition:color .2s ease; }
.foot-col a:hover{ color:var(--ink); text-decoration:underline; text-decoration-color:var(--rule-2); text-underline-offset:3px; }
.foot-bar{ display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px 24px; margin-top:56px; padding-top:20px; border-top:1px solid var(--rule); }
.copy{ font-family:var(--font-label); font-size:11px; letter-spacing:.08em; color:var(--muted); }
.foot-bar-r{ display:flex; align-items:center; gap:20px; }

/* ============ LOGO DARK-THEME INVERSION ============ */
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]) .logo-img{ filter:invert(1); }
}
:root[data-theme="dark"] .logo-img{ filter:invert(1); }

/* ============ RESPONSIVE ============ */
/* nav: brand + 7 links + 4 actions need a ~990px viewport in zh and ~1140px in en (measured with
   .tools/navfit.mjs); below that, plus ~50px of slack, the section links drop out and the actions stay */
@media (max-width:1200px){ body[data-lang="en"] .nav-links{ display:none; } }
@media (max-width:1040px){ .nav-links{ display:none; } }
@media (max-width:1080px){
  .modes{ grid-template-columns:1fr 1fr; row-gap:40px; }
  .mode:nth-child(odd){ padding-left:0; border-left:0; }
  .mode:nth-child(even){ padding-right:0; }
  .mode:nth-child(n+3){ border-top:1px solid var(--rule); }
  .catalog-grid{ grid-template-columns:repeat(3,minmax(0,1fr)); }
  .bounds{ grid-template-columns:1fr 1fr; row-gap:40px; }
}
@media (max-width:920px){
  .wrap{ width:calc(100% - 48px); }
  .sh{ display:block; }
  .sh-lede{ margin-top:18px; max-width:40em; }
  .hero-row{ display:block; }
  .hero-copy{ max-width:36em; }
  .sess{ margin-top:56px; max-width:640px; }
  .proofs{ grid-template-columns:1fr 1fr; }
  .proofs li:nth-child(3){ padding-left:0; border-left:0; }
  .proofs li:nth-child(n+3){ border-top:1px solid var(--rule); }
  .feature-head{ display:block; }
  .feature-side{ margin-top:24px; }
  .verify{ display:block; }
  .report{ position:static; margin-top:24px; }
  .chain-grid{ grid-template-columns:1fr; gap:36px; }
  .chain-sources{ grid-template-columns:repeat(3,minmax(0,1fr)); }
  .principles{ grid-template-columns:1fr; row-gap:36px; }
  .fig-side{ display:block; }
  .fig-side figcaption{ margin-top:16px; }
  .case{ display:block; }
  .case-card{ position:static; }
  .log{ margin-top:48px; }
  .get{ display:block; }
  .steps{ margin-top:56px; }
  .plans{ grid-template-columns:1fr; }
  .plan{ padding:28px 0 32px; }
  .plan + .plan{ border-left:0; border-top:1px solid var(--rule); }
  .plan.hot{ padding:28px 24px 32px; }
  .faq-grid{ display:block; }
  .faq-head{ position:static; }
  .faq-list{ margin-top:40px; }
  .foot-grid{ display:block; }
  .foot-cols{ margin-top:40px; }
  .catalog-grid{ grid-template-columns:1fr 1fr; }
}
@media (max-width:720px){
  .zoom-stage{ place-items:start; padding:4px 14px; }
  .zoom-stage img{ max-width:none; max-height:none; width:min(1720px,230vw); }
  .zoom-tip .t-fine{ display:none; }
  .zoom-tip .t-touch{ display:inline; }
}
@media (max-width:560px){
  .wrap{ width:calc(100% - 32px); }
  .nav-in{ gap:16px; }
  .nav-actions{ gap:14px; }
  .nav-login,.nav-signup{ display:none; }
  /* CJK display lines only break at punctuation (keep-all), so size them to the longest run:
     「每一步都有据可查。✓」 and 「到一份经得起追问的草稿。」 must fit a 320px phone */
  .hero-h1{ font-size:clamp(30px,9.2vw,44px); }
  .sh-title{ font-size:min(7.6vw,32px); }
  .hero-ctas .btn{ flex:1 1 auto; }
  .proofs{ grid-template-columns:1fr; }
  .proofs li,.proofs li + li{ padding:14px 0; border-left:0; }
  .proofs li + li{ border-top:1px solid var(--rule); }
  .sess-head,.sess-q,.sess-rows li,.sess-foot{ padding-left:16px; padding-right:16px; }
  .sess-rows li{ grid-template-columns:20px minmax(0,1fr); row-gap:8px; }
  .stamp{ grid-column:2; justify-self:start; }
  .win-bar{ padding:0 12px; }
  .win-badge{ display:none; }
  .modes{ grid-template-columns:1fr; row-gap:0; }
  .mode,.mode:nth-child(n){ padding:24px 0 32px; border-left:0; }
  .mode + .mode{ border-top:1px solid var(--rule); }
  .mode-top{ margin-bottom:18px; }
  .catalog-grid{ grid-template-columns:1fr 1fr; column-gap:16px; }
  .vcards{ grid-template-columns:1fr; }
  .vcard{ padding-bottom:32px; }
  .rrow{ grid-template-columns:1fr; gap:8px; padding:14px 16px; }
  .verdict{ justify-self:start; }
  .report-bar,.report-foot{ padding-left:16px; padding-right:16px; }
  .chain-sources{ grid-template-columns:1fr 1fr; }
  .bounds{ grid-template-columns:1fr; row-gap:32px; }
  .case-stats b{ font-size:36px; }
  body[data-lang="en"] .case-stats b{ font-size:44px; }
  .log-step{ grid-template-columns:40px minmax(0,1fr); }
  .log-dl > div,body[data-lang="en"] .log-dl > div{ grid-template-columns:1fr; gap:0; }
  .step{ grid-template-columns:52px minmax(0,1fr); }
  .dl-app{ font-size:19px; }
  .faq summary{ font-size:16px; }
  .faq p{ padding-right:0; }
  .foot-cols{ grid-template-columns:1fr 1fr; }
  .foot-col:last-child{ grid-column:1 / -1; }
}

/* ============ REDUCED MOTION ============ */
@media (prefers-reduced-motion: reduce){
  html{ scroll-behavior:auto; }
  .js .rv,.js .ln > span,.js .mark,.js .h1-check,.js .sess-rows li,.js .sess-rows .stamp{ transition:none !important; }
  .js .rv{ opacity:1; transform:none; }
  .js .ln > span{ transform:none; }
  .js .mark{ background-size:100% .07em; }
  .js .h1-check{ stroke-dashoffset:0; }
  .dot-live{ animation:none; }
  .pm::before,.pm::after,.shot-hint{ transition:none; }
}
@media (forced-colors: active){
  .mark{ background:none; text-decoration:underline; }
}
</style>
</head>
<body data-lang={lang} data-site="bioseeki">

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="a-ext" viewBox="0 0 24 24"><path d="M7 17 17 7M8.5 7H17v8.5"/></symbol>
    <symbol id="a-down" viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6"/></symbol>
    <symbol id="a-up" viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></symbol>
    <symbol id="a-right" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="a-mail" viewBox="0 0 24 24"><rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="m4 7 8 6 8-6"/></symbol>
    <symbol id="i-download" viewBox="0 0 24 24"><path d="M12 4v11M7 10l5 5 5-5M5 19.5h14"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></symbol>
    <symbol id="i-expand" viewBox="0 0 24 24"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"/></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></symbol>
    <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20h16"/><path d="M7 16v-5"/><path d="M12 16V7"/><path d="M17 16v-8"/></symbol>
    <symbol id="i-doc" viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></symbol>
    <symbol id="i-figure" viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="17" height="7" rx="1.5"/><path d="m6.5 18.5 3-2.5 3 1.5 4-3"/></symbol>
    <symbol id="i-quote" viewBox="0 0 24 24"><path d="M5 5h14v10H9l-4 4z"/><path d="M9 9.5h6M9 12h3.5"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.5 3 8.4 7 10 4-1.6 7-5.5 7-10V6z"/><path d="m9 12 2.2 2.2L15.5 10"/></symbol>
    <symbol id="i-redo" viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.35-5.65"/><path d="M20 4v5h-5"/></symbol>
    <symbol id="i-gap" viewBox="0 0 24 24"><path d="M4 7h9M4 12h5M4 17h9"/><rect x="14" y="10" width="6" height="4" rx="1" stroke-dasharray="2 2"/></symbol>
    <symbol id="i-hand" viewBox="0 0 24 24"><path d="M12 3v9M12 12l-3.5-3.5M12 12l3.5-3.5"/><rect x="4" y="14" width="16" height="7" rx="2"/></symbol>
    <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></symbol>
    <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.6 3.5 5.4 3.5 8.5s-1.1 5.9-3.5 8.5c-2.4-2.6-3.5-5.4-3.5-8.5s1.1-5.9 3.5-8.5z"/></symbol>
    <symbol id="i-nodata" viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="7" ry="2.5"/><path d="M5 6v6c0 1.4 3.1 2.5 7 2.5M19 6v4"/><path d="m15 15 5 5M20 15l-5 5"/></symbol>
  </defs>
</svg>

<nav class="nav" id="nav" aria-label={t.nav.aria}>
  <div class="wrap nav-in">
    <a class="brand" href="#top" aria-label={t.nav.home}>
      <img class="brand-mark logo-img" src="/bioseeki/mark.webp" alt="" width="24" height="24">
      <span class="brand-name">BioSeeki</span>
    </a>
    <div class="nav-links">
      {t.nav.items.map(([href, label]) => <a href={href}>{label}</a>)}
    </div>
    <div class="nav-actions">
      <a class="nav-text lang-switch" href={t.switchTo.href} hreflang={lang === "zh" ? "en" : "zh-CN"} title={t.switchTo.title} lang={lang === "zh" ? "en" : "zh-CN"}>{t.switchTo.label}</a>
      <a class="nav-text nav-login" href={t.links.signIn}>{t.nav.signIn}</a>
      <a class="btn btn-line btn-sm nav-signup" href={t.links.signUp}><Label text={t.nav.signUp} /></a>
      <a class="btn btn-ink btn-sm nav-dl" href={dlHref} download={dlAttr}><svg class="bi" aria-hidden="true"><use href="#i-download"/></svg>{t.nav.download}</a>
    </div>
  </div>
</nav>

<header class="hero" id="top">
  <div class="wrap">
    <div class="rh"><span>{t.hero.eyebrow}</span><span>{t.hero.meta}</span></div>
    <h1 class="hero-h1">
      <span class="ln"><span style="--d:.05s">{t.hero.h1a}</span></span>
      <span class="ln"><span style="--d:.2s">{h1pre}{markAt >= 0 && <span class="mark">{t.hero.h1mark}</span>}{h1post}<span class="nowrap">{stop}<svg class="h1-check" viewBox="0 0 48 48" aria-hidden="true"><path d="M7 26 19 37 42 11"/></svg></span></span></span>
    </h1>
    <div class="hero-row">
      <div class="hero-copy rv" style="--d:.45s">
        <p class="hero-sub" set:html={t.hero.sub} />
        <div class="hero-ctas">
          <a class="btn btn-ink btn-lg" href={dlHref} download={dlAttr}><svg class="bi" aria-hidden="true"><use href="#i-download"/></svg>{t.hero.download}</a>
          <a class="btn btn-line btn-lg" href={t.links.signUp}><Label text={t.hero.cta} /></a>
        </div>
        <p class="hero-meta"><a class="link" href="#demo"><Label text={t.hero.demo} /></a></p>
      </div>
      <aside class="sheet sess rv" id="hero-panel" style="--d:.6s" aria-label={t.hero.panelAria}>
        <div class="sess-head">
          <span class="label">{t.hero.panelTitle}</span>
          <span class="tag"><span class="dot dot-live"></span>{t.hero.panelBadge}</span>
        </div>
        <div class="sess-q"><span class="who">{t.hero.ask}</span><p>{t.hero.question}</p></div>
        <ol class="sess-rows">
          {t.hero.rows.map(([tool, msg, state, tone], i) => (
            <li class="ht-row"><span class="num">{nn(i + 1)}</span><span><span class="sess-tool">{tool}</span><span class="sess-msg">{msg}</span></span><span class={`stamp st-${tone}`}>{state}</span></li>
          ))}
        </ol>
        <div class="sess-foot"><span>{t.hero.panelFootL}</span><span set:html={t.hero.panelFootR} /></div>
      </aside>
    </div>
    <ul class="proofs rv">
      {t.hero.tags.map((tag) => <li><svg class="ck" aria-hidden="true"><use href="#i-check"/></svg>{tag}</li>)}
    </ul>
  </div>
</header>

<section id="tools"><div class="wrap">
  <div class="rh rv"><span>{t.tools.eyebrow}</span><span>{page(1)}</span></div>
  <div class="sh rv"><h2 class="sh-title">{t.tools.title}</h2><p class="sh-lede">{t.tools.lede}</p></div>
  <article class="feature">
    <div class="feature-head rv">
      <div class="feature-text">
        <p class="kicker"><span class="label">GeneCode</span><span class="status"><span class="dot"></span>{t.tools.gc.status}</span></p>
        <h3 class="feature-title">{t.tools.gc.h}</h3>
        <p class="feature-p">{t.tools.gc.p}</p>
      </div>
      <div class="feature-side">
        <ul class="plain-tags">{t.tools.gc.chips.map((c) => <li>{c}</li>)}</ul>
        <a class="link" href="https://genecode-agent.pages.dev" target="_blank" rel="noopener noreferrer"><Label text={t.tools.gc.link} /></a>
      </div>
    </div>
    <figure class="fig rv">
      <div class="win">
        <div class="win-bar"><i></i><i></i><i></i><span class="win-title">GENECODE / MAC BETA</span><span class="win-badge"><span class="dot"></span>{t.principles.screen.badge}</span></div>
        <button type="button" class="shot" data-caption={t.tools.gc.caption}><img src="/bioseeki/genecode-ui.webp" alt={t.tools.gc.alt} width="1698" height="653" loading="lazy"><span class="shot-hint"><svg class="bi" aria-hidden="true"><use href="#i-expand"/></svg>{t.zoom.hint}</span></button>
      </div>
      <figcaption><b>{t.figLabel} 1</b><span>{t.tools.gc.caption}</span></figcaption>
    </figure>
  </article>
  <div class="modes">
    {t.tools.modes.map((m, i) => (
      <article class="mode rv" style={`--d:${(i * 0.06).toFixed(2)}s`}>
        <div class="mode-top"><span class="num">{nn(i + 1)}</span><svg class="ico" aria-hidden="true"><use href={`#${m.icon}`}/></svg></div>
        <h3>{m.h}</h3>
        <p class="mode-p">{m.p}</p>
        <dl class="io">
          <div><dt>{t.tools.inLabel}</dt><dd>{m.in}</dd></div>
          <div class="io-out"><dt>{t.tools.outLabel}</dt><dd>{m.out}</dd></div>
        </dl>
        <p class="mono-tags">{m.chips.join(" · ")}</p>
      </article>
    ))}
  </div>
  <div class="catalog rv">
    <div class="catalog-head"><h3>{t.tools.catalogTitle}</h3><p>{t.tools.catalogNote}</p></div>
    <div class="catalog-grid">
      {t.tools.catalog.map((col) => (
        <div class="catalog-col">
          <p class="label label-ochre">{col.key}</p>
          <h4>{col.name}</h4>
          <ul>{col.items.map((item) => <li>{item}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</div></section>

<section id="verify"><div class="wrap">
  <div class="rh rv"><span>{t.verify.eyebrow}</span><span>{page(2)}</span></div>
  <div class="sh rv"><h2 class="sh-title">{t.verify.title}</h2><p class="sh-lede">{t.verify.lede}</p></div>
  <div class="verify">
    <div class="vcards">
      {t.verify.cards.map((c, i) => (
        <article class="vcard rv" style={`--d:${(i * 0.06).toFixed(2)}s`}><svg class="ico" aria-hidden="true"><use href={`#${c.icon}`}/></svg><h3>{c.h}</h3><p>{c.p}</p><code class="loc">{c.eg}</code></article>
      ))}
    </div>
    <aside class="sheet report rv" style="--d:.1s" aria-label={t.verify.reportAria}>
      <div class="report-bar"><span class="cmd">citecheck --bib refs.bib</span><span class="tag">{t.verify.illustrative}</span></div>
      <ol>
        {t.verify.report.map(([cls, verdict, text], i) => (
          <li class="rrow"><span class={`verdict ${cls}`}>{verdict}</span><p class="rtext"><small>[{i + 1}]</small>{text}</p></li>
        ))}
      </ol>
      <div class="report-foot"><span>{t.verify.reportFootL}</span><span>{t.verify.reportFootR}</span></div>
    </aside>
  </div>
</div></section>

<section id="principles"><div class="wrap">
  <div class="rh rv"><span>{t.principles.eyebrow}</span><span>{page(3)}</span></div>
  <div class="sh rv"><h2 class="sh-title">{t.principles.title}</h2><p class="sh-lede">{t.principles.lede}</p></div>
  <figure class="fig rv" aria-label={t.principles.chain.aria} data-chain>
    <div class="chain-plate">
      <div class="chain-grid">
        <svg class="chain-wires" aria-hidden="true"></svg>
        <div class="chain-col">
          <p class="chain-h">{t.principles.chain.cols[0]}</p>
          <ul class="chain-sources">{t.principles.chain.sources.map((s, i) => <li data-src={i}>{s}</li>)}</ul>
        </div>
        <div class="chain-col">
          <p class="chain-h">{t.principles.chain.cols[1]}</p>
          <div class="chain-core" data-core>
            {t.principles.chain.fragments.map(([file, loc], i) => (
              <div class="frag" data-frag={i}><span class="frag-file">{file}</span><span class="frag-loc">{loc}</span></div>
            ))}
            <p class="frag-note">{t.principles.chain.fragNote}</p>
          </div>
        </div>
        <div class="chain-col">
          <p class="chain-h">{t.principles.chain.cols[2]}</p>
          <div class="chain-draft">
            {t.principles.chain.claims.map(([text, ref], i) => (
              <p class="claim" data-claim={i}>{text}<span class="claim-ref">{ref}</span></p>
            ))}
            <p class="claim-gap">{t.principles.chain.gap}</p>
          </div>
        </div>
      </div>
    </div>
    <figcaption><b>{t.figLabel} 2</b><span>{t.principles.chain.title}</span><span class="cap-note">{t.principles.chain.foot}</span></figcaption>
  </figure>
  <div class="principles">
    {t.principles.cards.map((c, i) => (
      <article class="principle rv" style={`--d:${(i * 0.08).toFixed(2)}s`}><p class="label label-ochre">{c.num}</p><h3>{c.h}</h3><p class="principle-p">{c.p}</p></article>
    ))}
  </div>
  <figure class="fig fig-side rv">
    <div class="win">
      <div class="win-bar"><i></i><i></i><i></i><span class="win-title">{t.principles.screen.bar}</span><span class="win-badge"><span class="dot"></span>{t.principles.screen.badge}</span></div>
      <button type="button" class="shot shot-pad" data-caption={t.principles.screen.caption}><img src="/bioseeki/knowledge-ui.webp" alt={t.principles.screen.alt} width="1297" height="787" loading="lazy"><span class="shot-hint"><svg class="bi" aria-hidden="true"><use href="#i-expand"/></svg>{t.zoom.hint}</span></button>
    </div>
    <figcaption><b>{t.figLabel} 3</b><span>{t.principles.screen.caption}</span><span class="cap-note">{t.principles.screen.foot}</span><a class="link" href="/privacy"><Label text={t.principles.screen.link} /></a></figcaption>
  </figure>
</div></section>

<section id="workflow"><div class="wrap">
  <div class="rh rv"><span>{t.workflow.eyebrow}</span><span>{page(4)}</span></div>
  <div class="sh rv"><h2 class="sh-title">{t.workflow.title}</h2><p class="sh-lede">{t.workflow.lede}</p></div>
  <div class="case">
    <aside class="case-card rv">
      <p class="label label-ochre">{t.workflow.case.label}</p>
      <p class="case-q">{t.workflow.case.question}</p>
      <dl class="case-meta">{t.workflow.case.meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <ul class="case-stats">{t.workflow.case.stats.map(([n, l], i) => <li class={i === 3 ? "is-gap" : undefined}><b>{n}</b><span>{l}</span></li>)}</ul>
      <p class="case-note">{t.workflow.case.note}</p>
    </aside>
    <ol class="log">
      {t.workflow.steps.map((s, i) => (
        <li class="log-step rv">
          <span class="num">{nn(i + 1)}</span>
          <div>
            <h3>{s.h}</h3>
            <dl class="log-dl">
              <div><dt>{t.workflow.usedLabel}</dt><dd class="mono-tags">{s.used.join(" · ")}</dd></div>
              <div><dt>{t.workflow.outLabel}</dt><dd>{s.out}</dd></div>
              {s.basis && <div><dt>{t.workflow.basisLabel}</dt><dd><code class="loc">{s.basis}</code></dd></div>}
            </dl>
            {s.confirm && <p class="confirm"><span>{t.workflow.confirmLabel}</span>{s.confirm}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
  <figure class="fig fig-wide rv">
    <div class="win">
      <div class="win-bar"><i></i><i></i><i></i><span class="win-title">{t.workflow.screen.bar}</span><span class="win-badge"><span class="dot"></span>{t.workflow.screen.badge}</span></div>
      <button type="button" class="shot" data-caption={t.workflow.screen.caption}><img src="/bioseeki/home-ui.webp" alt={t.workflow.screen.alt} width="1698" height="644" loading="lazy"><span class="shot-hint"><svg class="bi" aria-hidden="true"><use href="#i-expand"/></svg>{t.zoom.hint}</span></button>
    </div>
    <figcaption><b>{t.figLabel} 4</b><span>{t.workflow.screen.caption}</span><span class="cap-note">{t.workflow.screen.footL} {t.workflow.screen.footR}</span></figcaption>
  </figure>
  <div class="bounds">
    {t.workflow.bounds.map((b, i) => (
      <article class="bound rv" style={`--d:${(i * 0.06).toFixed(2)}s`}><svg class="ico" aria-hidden="true"><use href={`#${b.icon}`}/></svg><h3>{b.h}</h3><p>{b.p}</p></article>
    ))}
  </div>
</div></section>

<section id="demo" class="band"><div class="wrap">
  <div class="rh rv"><span>{t.demo.eyebrow}</span><span>{page(5)}</span></div>
  <div class="sh rv"><h2 class="sh-title">{t.demo.title}</h2><p class="sh-lede">{t.demo.lede}</p></div>
  <div class="film rv">
    <video controls playsinline preload="none" poster="/bioseeki/demo-poster.jpg" aria-label={t.demo.aria}>
      <source src="/bioseeki/demo.mp4" type="video/mp4">
      <track kind="captions" src="/bioseeki/captions.zh.vtt" srclang="zh" label={t.demo.captionsLabel}>
      {t.demo.fallback}<a href="/bioseeki/demo.mp4">{t.demo.download}</a>
    </video>
  </div>
  <div class="film-foot rv"><span><span class="label">{t.demo.badge}</span>{t.demo.foot}</span><a class="link" href="/bioseeki/demo.mp4" download><Label text={t.demo.download} /></a></div>
</div></section>

<section id="download"><div class="wrap">
  <div class="rh rv"><span>{t.download.eyebrow}</span><span>{page(6)}</span></div>
  <div class="sh rv"><h2 class="sh-title">{t.download.title}</h2><p class="sh-lede">{t.download.lede}</p></div>
  <div class="get">
    <article class="sheet dl rv">
      <div class="dl-top">
        <img class="dl-mark logo-img" src="/bioseeki/mark.webp" alt="" width="30" height="30">
        <p class="dl-app">{t.download.app}</p>
        <span class="tag">{t.download.badge}</span>
      </div>
      <dl class="specs">
        {t.download.specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <p class="dl-note">{t.download.note}</p>
      <div class="dl-actions">
        {MAC_DMG_URL
          ? <a class="btn btn-ink btn-lg" href={MAC_DMG_URL} download><svg class="bi" aria-hidden="true"><use href="#i-download"/></svg>{t.download.cta}</a>
          : <>
              <p class="dl-soon"><span class="dot dot-live" aria-hidden="true"></span>{t.download.soon}</p>
              <a class="btn btn-ink btn-lg" href={mailto}><Label text={t.download.mailCta} /></a>
            </>}
      </div>
      <p class="dl-legal" set:html={t.download.legal} />
    </article>
    <div class="steps rv" style="--d:.1s">
      <p class="label">{t.download.stepsLabel}</p>
      <ol>
        {t.download.steps.map(([n, h, d], i) => (
          <li class="step">
            <span class="step-n">{n}</span>
            <div><h3>{h}</h3><p>{d}</p>{i === 0 ? <a class="btn btn-line btn-sm" href={t.links.signUp}><Label text={t.download.signUp} /></a> : null}</div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</div></section>

<section id="pricing"><div class="wrap">
  <div class="rh rv"><span>{t.pricing.eyebrow}</span><span>{page(7)}</span></div>
  <div class="sh rv"><h2 class="sh-title">{t.pricing.title}</h2><p class="sh-lede">{t.pricing.lede}</p></div>
  <div class="plans">
    {t.pricing.plans.map((p, i) => (
      <article class={`plan rv${p.tag ? " hot" : ""}`} style={`--d:${(i * 0.08).toFixed(2)}s`}>
        <div class="plan-head"><p class="plan-name">{p.name}</p>{p.tag ? <span class="tag tag-ink">{p.tag}</span> : null}</div>
        <p class="plan-price"><span class="plan-cur">¥</span><b>{p.price}</b><span class="plan-per">{t.pricing.per}</span></p>
        <p class="plan-credits"><b>{p.credits}</b> credits</p>
        <span class="meter" aria-hidden="true"><i style={`width:${Math.round((creditsOf(p.credits) / maxCredits) * 100)}%`}></i></span>
        <p class="plan-sub">{p.sub}</p>
        <a class={`btn btn-lg plan-cta ${p.tag ? "btn-ink" : "btn-line"}`} href={t.links.plans}><Label text={t.pricing.cta} /></a>
      </article>
    ))}
  </div>
</div></section>

<section id="faq"><div class="wrap">
  <div class="rh rv"><span>{t.faq.eyebrow}</span><span>{page(8)}</span></div>
  <div class="faq-grid">
    <div class="faq-head rv"><h2 class="sh-title">{t.faq.title}</h2><p class="sh-lede" set:html={t.faq.lede} /></div>
    <div class="faq-list">
      {t.faq.items.map((f, i) => (
        <details class="faq rv" style={`--d:${(i * 0.04).toFixed(2)}s`} open={i === 0}>
          <summary>{f.q}<span class="pm" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</div></section>

<footer class="foot"><div class="wrap">
  <p class="foot-tag rv">{t.footer.tagA}<em>{t.footer.tagB}</em></p>
  <div class="foot-grid">
    <div class="foot-brand">
      <a class="brand" href="#top" aria-label={t.nav.home}><img class="brand-mark logo-img" src="/bioseeki/mark.webp" alt="" width="24" height="24"><span class="brand-name">BioSeeki</span></a>
      <p class="foot-slogan">{t.footer.slogan}</p>
    </div>
    <nav class="foot-cols" aria-label={t.footer.aria}>
      {t.footer.groups.map((g) => (
        <div class="foot-col">
          <p class="foot-col-title">{g.title}</p>
          <ul>
            {g.links.map(([href, label, flag]) => (
              <li><a href={href} target={flag === "ext" ? "_blank" : undefined} rel={flag === "ext" ? "noopener noreferrer" : undefined}><Label text={label} /></a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="foot-bar">
    <p class="copy">{t.footer.copy}</p>
    <div class="foot-bar-r">
      <a class="nav-text lang-switch" href={t.switchTo.href} hreflang={lang === "zh" ? "en" : "zh-CN"}>{t.switchTo.label}</a>
      <a class="nav-text" href="#top"><Label text={t.footer.top} /></a>
    </div>
  </div>
</div></footer>

<dialog class="zoom" id="zoom" aria-label={t.zoom.aria}>
  <div class="zoom-top"><p class="zoom-cap" id="zoom-cap"></p><button type="button" class="zoom-close" id="zoom-close" aria-label={t.zoom.close}><svg class="bi" aria-hidden="true"><use href="#i-close"/></svg></button></div>
  <div class="zoom-stage" id="zoom-stage"><img id="zoom-img" alt=""></div>
  <p class="zoom-tip"><span class="t-fine">{t.zoom.fine}</span><span class="t-touch">{t.zoom.touch}</span></p>
</dialog>

<script is:inline>
(function(){
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* hero type: the lines rise, then the underline and the check draw in — once the display face
     is ready (or after 700ms, whichever comes first) so the type never swaps mid-motion */
  var hero = document.getElementById("top");
  var heroGo = false;
  var startHero = function(){ if (heroGo) return; heroGo = true; requestAnimationFrame(function(){ hero.classList.add("in"); }); };
  if (reduced) startHero();
  else {
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(startHero);
    setTimeout(startHero, 700);
  }

  /* scroll reveal */
  var revealed = document.querySelectorAll(".rv");
  if (reduced || !("IntersectionObserver" in window)) {
    revealed.forEach(function(el){ el.classList.add("in"); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); }
      });
    }, { threshold:.12, rootMargin:"0px 0px -40px 0px" });
    revealed.forEach(function(el){ io.observe(el); });
  }

  /* nav: paper backing once the page moves */
  var nav = document.getElementById("nav");
  var onScroll = function(){ nav.classList.toggle("scrolled", window.scrollY > 16); };
  window.addEventListener("scroll", onScroll, { passive:true });
  onScroll();

  /* nav: mark the section that crosses the upper-middle of the viewport */
  var links = Array.prototype.slice.call(document.querySelectorAll('.nav-links a[href^="#"]'));
  var targets = links.map(function(a){ return document.getElementById(a.getAttribute("href").slice(1)); });
  var spyQueued = false;
  function spy(){
    spyQueued = false;
    var line = window.innerHeight * 0.45;
    links.forEach(function(a, i){
      var t = targets[i], r = t && t.getBoundingClientRect();
      if (r && r.top <= line && r.bottom > line) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    });
  }
  window.addEventListener("scroll", function(){ if (!spyQueued){ spyQueued = true; requestAnimationFrame(spy); } }, { passive:true });
  spy();

  /* screenshots: click to see them full size */
  var finePointer = window.matchMedia("(hover:hover) and (pointer:fine)").matches;
  var dlg = document.getElementById("zoom");
  var zImg = document.getElementById("zoom-img"), zCap = document.getElementById("zoom-cap"), zStage = document.getElementById("zoom-stage");
  document.querySelectorAll(".shot").forEach(function(btn){
    btn.addEventListener("click", function(){
      var img = btn.querySelector("img"), src = img.currentSrc || img.src;
      if (!dlg || typeof dlg.showModal !== "function"){ window.open(src, "_blank", "noopener"); return; }
      zImg.src = src; zImg.alt = img.alt;
      zCap.textContent = btn.getAttribute("data-caption") || img.alt;
      dlg.showModal();
      zStage.scrollTo(0, 0);
    });
  });
  if (dlg){
    document.getElementById("zoom-close").addEventListener("click", function(){ dlg.close(); });
    dlg.addEventListener("click", function(e){
      if (e.target === dlg || e.target === zStage || (finePointer && e.target === zImg)) dlg.close();
    });
  }

  /* evidence chain: draw wires from each source to the knowledge base and from each
     fragment to the claim it supports, measured from the live layout so they follow
     reflow (three columns on desktop, stacked on phones) */
  var chain = document.querySelector("[data-chain]");
  if (chain){
    var chainGrid = chain.querySelector(".chain-grid"), svg = chain.querySelector(".chain-wires");
    var drawWires = function(){
      var g = chainGrid.getBoundingClientRect();
      var core = chain.querySelector("[data-core]").getBoundingClientRect();
      var stacked = core.top > chain.querySelector("[data-src]").getBoundingClientRect().bottom;
      var html = "";
      var wire = function(d, ex, ey){ html += '<path class="wire" d="' + d + '"/><circle class="wire-end" cx="' + ex + '" cy="' + ey + '" r="2.5"/>'; };
      if (stacked){
        // phones: one clean vertical link between each stage instead of per-item wires
        var blocks = [chain.querySelector(".chain-sources"), chain.querySelector("[data-core]"), chain.querySelector(".chain-draft")].map(function(el){ return el.getBoundingClientRect(); });
        for (var k = 0; k < 2; k++){
          var x = g.width / 2, y1 = blocks[k].bottom - g.top + 6, y2 = blocks[k + 1].top - g.top - 6;
          wire("M" + x + " " + y1 + " L" + x + " " + y2, x, y2);
        }
      } else {
        var srcs = chain.querySelectorAll("[data-src]");
        srcs.forEach(function(el, i){
          var a = el.getBoundingClientRect(), f = srcs.length > 1 ? i / (srcs.length - 1) : 0.5;
          var sx = a.right - g.left, sy = a.top + a.height / 2 - g.top;
          // sources fan into the knowledge base across its height, in order
          var ex = core.left - g.left, ey = core.top - g.top + core.height * (0.14 + 0.72 * f), mx = (sx + ex) / 2;
          wire("M" + sx + " " + sy + " C" + mx + " " + sy + "," + mx + " " + ey + "," + ex + " " + ey, ex, ey);
        });
        chain.querySelectorAll("[data-frag]").forEach(function(el){
          var claim = chain.querySelector('[data-claim="' + el.getAttribute("data-frag") + '"]');
          if (!claim) return;
          var a = el.getBoundingClientRect(), c = claim.getBoundingClientRect();
          var sx = a.right - g.left, sy = a.top + a.height / 2 - g.top, ex = c.left - g.left - 4, ey = c.top + 12 - g.top, mx = (sx + ex) / 2;
          wire("M" + sx + " " + sy + " C" + mx + " " + sy + "," + mx + " " + ey + "," + ex + " " + ey, ex, ey);
        });
      }
      svg.setAttribute("viewBox", "0 0 " + g.width + " " + g.height);
      svg.innerHTML = html;
    };
    drawWires();
    var wireQueued = false;
    window.addEventListener("resize", function(){ if (!wireQueued){ wireQueued = true; requestAnimationFrame(function(){ wireQueued = false; drawWires(); }); } });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(drawWires);
  }

  /* hero session: light the steps one by one, replay while visible */
  var rows = document.querySelectorAll("#hero-panel .ht-row");
  if (reduced || !rows.length){
    rows.forEach(function(r){ r.classList.add("on"); });
    return;
  }
  var panel = document.getElementById("hero-panel");
  var visible = true, timer = null;
  function play(){
    clearTimeout(timer);
    rows.forEach(function(r){ r.classList.remove("on"); });
    var i = 0;
    (function next(){
      if (i < rows.length){ rows[i++].classList.add("on"); timer = setTimeout(next, 900); }
      else { timer = setTimeout(function(){ if (visible && !document.hidden) play(); }, 6000); }
    })();
  }
  if ("IntersectionObserver" in window){
    new IntersectionObserver(function(entries){
      var was = visible; visible = entries[0].isIntersecting;
      if (visible && !was) play();
    }, { threshold:.3 }).observe(panel);
  }
  document.addEventListener("visibilitychange", function(){ if (!document.hidden && visible) play(); });
  setTimeout(play, 1200);
})();
</script>
</body>
</html>
