<script is:inline>
(function(){
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* scroll reveal */
  var revealed = document.querySelectorAll(".reveal");
  if (reduced || !("IntersectionObserver" in window)) {
    revealed.forEach(function(el){ el.classList.add("in"); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); }
      });
    }, { threshold:.15, rootMargin:"0px 0px -40px 0px" });
    revealed.forEach(function(el){ io.observe(el); });
  }

  /* nav glass on scroll */
  var nav = document.getElementById("nav");
  var onScroll = function(){ nav.classList.toggle("scrolled", window.scrollY > 24); };
  window.addEventListener("scroll", onScroll, { passive:true });
  onScroll();

  /* nav: mark the section that crosses the upper-middle of the viewport */
  var links = Array.prototype.slice.call(document.querySelectorAll('.nav-links a[href^="#"]'));
  var targets = links.map(function(a){ return document.getElementById(a.getAttribute("href").slice(1)); });
  var ind = document.querySelector(".nav-ind");
  var spyQueued = false;
  function spy(){
    spyQueued = false;
    var line = window.innerHeight * 0.45, current = null;
    links.forEach(function(a, i){
      var t = targets[i], r = t && t.getBoundingClientRect();
      if (r && r.top <= line && r.bottom > line){ a.setAttribute("aria-current", "true"); current = a; }
      else a.removeAttribute("aria-current");
    });
    /* the pill slides to the current link (offsets are relative to .nav-links) */
    if (ind){
      if (current && current.offsetWidth){ ind.style.width = current.offsetWidth + "px"; ind.style.transform = "translateX(" + current.offsetLeft + "px)"; ind.style.opacity = "1"; }
      else ind.style.opacity = "0";
    }
  }
  window.addEventListener("resize", function(){ if (!spyQueued){ spyQueued = true; requestAnimationFrame(spy); } });
  window.addEventListener("scroll", function(){ if (!spyQueued){ spyQueued = true; requestAnimationFrame(spy); } }, { passive:true });
  spy();

  var finePointer = window.matchMedia("(hover:hover) and (pointer:fine)").matches;

  /* cursor light: a soft glow and a patch of lit grid trail the pointer; the glass panel
     under it gets a spotlight and a lit stretch of edge. Mouse/trackpad only, never with
     reduced motion. */
  if (finePointer && !reduced){
    var root = document.documentElement;
    var glow = document.querySelector(".cfx-glow"), grid = document.querySelector(".cfx-grid");
    document.querySelectorAll(".glass").forEach(function(el){ el.classList.add("spot"); });
    /* not .log: its ::before/::after draw the progress rail */
    document.querySelectorAll(".suite, .report, .chain, .case-card, .bounds, .demo-glass, .dl, .plan, .faq-list, .foot-card").forEach(function(el){ el.classList.add("spot-edge"); });
    var tx = 0, ty = 0, g1 = { x:0, y:0 };
    var running = false;
    var mod = function(a, n){ return ((a % n) + n) % n; };
    var kick = function(){ if (!running){ running = true; requestAnimationFrame(frame); } };
    var frame = function(){
      g1.x += (tx - g1.x) * .12; g1.y += (ty - g1.y) * .12;
      glow.style.transform = "translate3d(" + g1.x + "px," + g1.y + "px,0)";
      /* the lit grid sits on the pointer; offset its pattern so the lines match the
         background grid (.orbs::before: centred horizontally, anchored at the top) */
      var vw = root.clientWidth, gs = vw >= 768 ? 56 : 40;
      grid.style.transform = "translate3d(" + tx + "px," + ty + "px,0)";
      grid.style.backgroundPosition = mod((vw - gs) / 2 - (tx - 210), gs) + "px " + mod(-(ty - 210), gs) + "px";
      var busy = Math.abs(tx - g1.x) + Math.abs(ty - g1.y) > .5;
      if (busy) requestAnimationFrame(frame); else running = false;
    };
    /* base: when the pointer enters a grid cell over open background, a random nucleotide rises out
       of that cell; the previous one leaves at the same moment, so one letter shows at a time. At most
       ~3 new letters a second (a move that comes sooner is caught up when the window ends), and a
       letter fades by itself if the pointer rests. Nothing appears over the glass panels. */
    var basesLayer = document.querySelector(".cfx-bases"), BASES = ["A", "C", "G", "T"], baseCells = [];
    var curBase = null, curKey = "", lastSpawn = -1e9, holdTimer = 0, catchUp = 0, nextBase = 0, onGlass = false;
    if (basesLayer) for (var bi = 0; bi < 3; bi++){ var bc = document.createElement("span"); bc.className = "base"; bc.appendChild(document.createElement("b")); basesLayer.appendChild(bc); baseCells.push(bc); }
    var hideBase = function(){
      clearTimeout(holdTimer);
      if (curBase){ curBase.classList.remove("in"); curBase.classList.add("out"); }
      curBase = null; curKey = "";
    };
    var showBase = function(x, y){
      if (!baseCells.length) return;
      var vw = root.clientWidth, gs = vw >= 768 ? 56 : 40, x0 = mod((vw - gs) / 2, gs);
      var i = Math.floor((x - x0) / gs), j = Math.floor(y / gs), key = i + "," + j;
      if (key === curKey) return; /* still in the same cell: keep its letter */
      var wait = 320 - (performance.now() - lastSpawn);
      if (wait > 0){
        if (!catchUp) catchUp = setTimeout(function(){ catchUp = 0; if (!onGlass && !root.classList.contains("fx-away")) showBase(tx, ty); }, wait);
        return;
      }
      hideBase();
      var el = baseCells[nextBase++ % baseCells.length], b = el.firstChild, base = BASES[Math.random() * 4 | 0];
      b.style.transition = "none"; /* jump to the start state without animating there */
      el.className = "base base-" + base; b.textContent = base;
      el.style.width = el.style.height = (gs - 1) + "px";
      b.style.fontSize = Math.round(gs * .42) + "px";
      el.style.transform = "translate3d(" + (x0 + i * gs + 1) + "px," + (j * gs + 1) + "px,0)";
      void el.offsetWidth;
      b.style.transition = "";
      el.classList.add("in");
      curBase = el; curKey = key; lastSpawn = performance.now();
      holdTimer = setTimeout(hideBase, 1400);
    };
    window.addEventListener("pointermove", function(e){
      if (e.pointerType === "touch") return;
      tx = e.clientX; ty = e.clientY;
      onGlass = !!(e.target.closest && e.target.closest(".glass, .nav"));
      if (onGlass) hideBase(); else showBase(tx, ty);
      if (!root.classList.contains("fx-on")){ g1.x = tx; g1.y = ty; root.classList.add("fx-on"); }
      root.classList.remove("fx-away");
      var card = e.target.closest ? e.target.closest(".spot") : null;
      if (card){
        var r = card.getBoundingClientRect();
        card.style.setProperty("--sx", (tx - r.left) + "px");
        card.style.setProperty("--sy", (ty - r.top) + "px");
      }
      kick();
    }, { passive:true });
    document.addEventListener("mouseleave", function(){ root.classList.add("fx-away"); hideBase(); });
    window.addEventListener("blur", function(){ root.classList.add("fx-away"); });
  }

  /* evidence chain: draw wires from each source to the knowledge base and from each
     fragment to the claim it supports, measured from the live layout so they follow
     reflow (three columns on desktop, stacked on phones) */
  var chain = document.querySelector("[data-chain]");
  if (chain){
    var chainGrid = chain.querySelector(".chain-grid"), svg = chain.querySelector(".chain-wires");
    var NS = "http://www.w3.org/2000/svg";
    var drawWires = function(){
      var g = chainGrid.getBoundingClientRect();
      var core = chain.querySelector("[data-core]").getBoundingClientRect();
      var stacked = core.top > chain.querySelector("[data-src]").getBoundingClientRect().bottom;
      var html = "";
      var nIn = 0, nOut = 0;
      var wire = function(kind, d, i){
        var delay = kind === "in" ? nIn++ * 0.07 : 0.55 + nOut++ * 0.16;
        html += '<g class="wire-' + kind + '"' + (i != null ? ' data-i="' + i + '"' : "") + '><path class="wire" pathLength="1" style="--wd:' + delay.toFixed(2) + 's" d="' + d + '"/><path class="wire-flow" d="' + d + '"/></g>';
      };
      if (stacked){
        // phones: one clean vertical link between each stage instead of per-item wires
        var blocks = [chain.querySelector(".chain-sources"), chain.querySelector("[data-core]"), chain.querySelector(".chain-draft")].map(function(el){ return el.getBoundingClientRect(); });
        for (var k = 0; k < 2; k++){
          var x = g.width / 2, y1 = blocks[k].bottom - g.top + 4, y2 = blocks[k + 1].top - g.top - 4;
          wire(k ? "out" : "in", "M" + x + " " + y1 + " L" + x + " " + y2);
        }
      } else {
        var srcs = chain.querySelectorAll("[data-src]");
        srcs.forEach(function(el, i){
          var a = el.getBoundingClientRect(), f = srcs.length > 1 ? i / (srcs.length - 1) : 0.5;
          var sx = a.right - g.left, sy = a.top + a.height / 2 - g.top;
          // sources fan into the knowledge base across its height, in order
          var ex = core.left - g.left, ey = core.top - g.top + core.height * (0.14 + 0.72 * f), mx = (sx + ex) / 2;
          wire("in", "M" + sx + " " + sy + " C" + mx + " " + sy + "," + mx + " " + ey + "," + ex + " " + ey);
        });
        chain.querySelectorAll("[data-frag]").forEach(function(el){
          var i = el.getAttribute("data-frag"), claim = chain.querySelector('[data-claim="' + i + '"]');
          if (!claim) return;
          var a = el.getBoundingClientRect(), c = claim.getBoundingClientRect();
          var sx = a.right - g.left, sy = a.top + a.height / 2 - g.top, ex = c.left - g.left, ey = c.top + c.height / 2 - g.top, mx = (sx + ex) / 2;
          wire("out", "M" + sx + " " + sy + " C" + mx + " " + sy + "," + mx + " " + ey + "," + ex + " " + ey, i);
        });
      }
      svg.setAttribute("viewBox", "0 0 " + g.width + " " + g.height);
      svg.innerHTML = html;
      if (lit != null) light(lit);
    };
    /* light one fragment, its claim and the link between them */
    var lit = null;
    var light = function(i){
      lit = i;
      chain.querySelectorAll(".is-hl").forEach(function(el){ el.classList.remove("is-hl"); });
      if (i == null) return;
      chain.querySelectorAll('[data-frag="' + i + '"], [data-claim="' + i + '"], .wire-out[data-i="' + i + '"]').forEach(function(el){ el.classList.add("is-hl"); });
    };
    var pairs = chain.querySelectorAll("[data-frag]").length, hovering = false, cycle = null, step = -1;
    chain.querySelectorAll("[data-frag], [data-claim]").forEach(function(el){
      var i = el.getAttribute("data-frag") || el.getAttribute("data-claim");
      el.addEventListener("mouseenter", function(){ hovering = true; light(i); });
      el.addEventListener("mouseleave", function(){ hovering = false; });
    });
    /* while the figure is on screen, walk through the pairs on its own */
    if (!reduced && "IntersectionObserver" in window && pairs){
      new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting && !cycle){
            cycle = setInterval(function(){ if (!hovering){ step = (step + 1) % pairs; light(String(step)); } }, 2600);
          } else if (!e.isIntersecting && cycle){ clearInterval(cycle); cycle = null; light(null); }
        });
      }, { threshold:.35 }).observe(chain);
    }
    drawWires();
    var wireQueued = false;
    window.addEventListener("resize", function(){ if (!wireQueued){ wireQueued = true; requestAnimationFrame(function(){ wireQueued = false; drawWires(); }); } });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(drawWires);
  }

  var once = function(el, threshold, fn){
    var io2 = new IntersectionObserver(function(entries){ entries.forEach(function(e){ if (e.isIntersecting){ io2.disconnect(); fn(); } }); }, { threshold:threshold });
    io2.observe(el);
  };
  var canAnimate = !reduced && "IntersectionObserver" in window;

  /* citation report: type the command, then resolve each line from "checking" to its verdict */
  var report = document.querySelector(".report");
  if (report && canAnimate){
    report.classList.add("armed");
    once(report, .45, function(){
      report.classList.add("typing");
      var rows = report.querySelectorAll(".rrow");
      rows.forEach(function(row, i){ setTimeout(function(){ row.classList.add("done"); }, 1300 + i * 650); });
      setTimeout(function(){ report.classList.add("complete"); }, 1300 + rows.length * 650);
    });
  }

  /* project card: the counts run up from zero */
  var stats = document.querySelector(".case-stats");
  if (stats && canAnimate){
    var nums = Array.prototype.slice.call(stats.querySelectorAll("b")).map(function(b){ return { el:b, to:parseInt(b.textContent, 10) }; }).filter(function(n){ return n.to > 0; });
    nums.forEach(function(n){ n.el.textContent = "0"; });
    once(stats, .3, function(){
      var t0 = performance.now(), dur = 900;
      var tick = function(now){
        var k = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - k, 3);
        nums.forEach(function(n){ n.el.textContent = String(Math.round(n.to * e)); });
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }

  /* project log: each step lights up once it reaches the lower third of the screen; the rail follows */
  var log = document.querySelector(".log");
  if (log && canAnimate){
    var steps = Array.prototype.slice.call(log.querySelectorAll(".log-step"));
    var marks = steps.map(function(st){ return st.querySelector(".log-n"); });
    var placeRail = function(){
      var L = log.getBoundingClientRect(), a = marks[0].getBoundingClientRect(), b = marks[marks.length - 1].getBoundingClientRect();
      log.style.setProperty("--rail-x", (a.left - L.left + a.width / 2) + "px");
      log.style.setProperty("--rail-top", (a.top - L.top + a.height / 2) + "px");
      log.style.setProperty("--rail-h", (b.top - a.top) + "px");
    };
    var logQueued = false;
    var progress = function(){
      logQueued = false;
      var line = window.innerHeight * 0.68, last = -1;
      marks.forEach(function(mk, i){ var on = mk.getBoundingClientRect().top < line; steps[i].classList.toggle("done", on); if (on) last = i; });
      log.style.setProperty("--rail-p", last <= 0 ? 0 : last / (marks.length - 1));
    };
    placeRail(); progress();
    window.addEventListener("scroll", function(){ if (!logQueued){ logQueued = true; requestAnimationFrame(progress); } }, { passive:true });
    window.addEventListener("resize", function(){ placeRail(); progress(); });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(placeRail);
  }

  /* demo: our play button over the poster; the native controls take over from the first play */
  var player = document.querySelector("[data-player]");
  if (player){
    var pv = player.querySelector("video"), pb = player.querySelector("[data-play]");
    var started = function(){ player.classList.add("playing"); pv.controls = true; };
    pv.controls = false; pb.hidden = false;
    pb.addEventListener("click", function(){ started(); var p = pv.play(); if (p && p.catch) p.catch(function(){}); pv.focus(); });
    pv.addEventListener("play", started);
  }

  /* hero background loop: play only the variant for the current theme; never with reduced motion */
  var heroVideos = Array.prototype.slice.call(document.querySelectorAll("[data-hero-video]"));
  if (heroVideos.length && !reduced && window.matchMedia("(min-width: 561px)").matches){
    var pickVideo = function(){
      heroVideos.forEach(function(v){
        if (getComputedStyle(v).display === "none"){ v.pause(); return; }
        if (v.preload !== "auto"){ v.preload = "auto"; v.load(); }
        var p = v.play(); if (p && p.catch) p.catch(function(){});
      });
    };
    pickVideo();
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", pickVideo);
  }
})();
</script>
<script is:inline>
/* 登录后右上角把「登录/注册」换成头像：控制台（api.bioseeki.com）登录时会把 bs_name
   写到 .bioseeki.com 域名下的 cookie，官网读到就替换。这两个 cookie **只用于显示**，
   不含任何凭证 —— 就算被伪造，也只是显示一个空头像，看不到任何账户数据。 */
(function () {
  var login = document.getElementById("navLogin"), signup = document.getElementById("navSignup");
  var account = document.getElementById("navAccount"), user = document.getElementById("navUser");
  var menu = document.getElementById("navAccountMenu"), avatar = document.getElementById("navAvatar"), uname = document.getElementById("navUname");
  if (!account || !user || !menu || !avatar) return;
  function close(focus) { menu.hidden = true; user.setAttribute("aria-expanded", "false"); if (focus) user.focus(); }
  function sync() {
