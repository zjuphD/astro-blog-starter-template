---
export const prerender = false;
import release from '../data/desktop-release.json';
const fileSize = `${Math.round(release.bytes / 1_000_000)} MB`;
const minimumMacOS = release.minimumMacOS.replace(/\.0$/, "");
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>下载 BioSeeki · Mac Beta {release.version}</title>
  <meta name="description" content={`下载已通过 Apple 公证的 BioSeeki Mac Beta ${release.version}，适用于 Apple 芯片和 macOS ${minimumMacOS} 及以上系统。`} />
  <meta name="theme-color" content="#f0eee8" /><link rel="icon" href="/favicon.ico" />
  <link rel="canonical" href="https://bioseeki.com/download" />
</head>
<body>
  <header><a class="brand" href="/" aria-label="BioSeeki 官网"><img src="/product-assets/bioseeki-logo.svg" alt="BioSeeki" width="146" height="35" /></a><a href="/">返回官网 ↗</a></header>
  <main>
    <div class="intro"><p class="eyebrow">BIOSEEKI / MAC BETA</p><h1>从下一个<br /><span>科研问题开始。</span></h1><p class="lede">读文献、分析数据、设计实验。<br />让研究，接着向前。</p></div>
    <section aria-labelledby="download-title"><p class="eyebrow">为你的电脑准备</p><h2 id="download-title">BioSeeki for macOS</h2><p>Mac Beta 现已开放下载，已通过 Apple 公证。</p><a class="button" href={release.downloadUrl} download={release.filename}>下载 Mac Beta <span>{fileSize} ↓</span></a><dl><div><dt>版本</dt><dd>{release.version} Beta</dd></div><div><dt>芯片</dt><dd>Apple 芯片 · M 系列</dd></div><div><dt>系统</dt><dd>macOS {minimumMacOS} 及以上</dd></div><div><dt>Windows</dt><dd>尚未开放下载</dd></div></dl><p class="note">打开 DMG，双击 BioSeeki Beta，按提示点击「安装到应用程序」，完成后会自动打开。也可以拖入「Applications」文件夹安装。以后从访达的「应用程序」启动，登录 BioSeeki 账号即可开始。暂不支持 Intel 芯片的 Mac。</p><p class="note"><a class="link" href="https://api.bioseeki.com/sign-up?redirect=/me">创建账户 ↗</a><span aria-hidden="true"> · </span><a class="link" href={release.checksumUrl}>校验值（SHA-256）</a></p></section>
  </main>
  <footer><span>BioSeeki © 2026</span><div><a href="mailto:support@bioseeki.com">联系支持</a><a href="/privacy">隐私政策</a><a href="/terms">服务条款</a></div></footer>
</body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(html){background:#f0eee8;color:#173532;font-family:'PingFang SC','Microsoft YaHei',Arial,sans-serif;-webkit-font-smoothing:antialiased} :global(body){margin:0;line-height:1.8} :global(a){color:inherit;text-decoration:none} :global(a:focus-visible){outline:2px solid #567e70;outline-offset:5px}
  header,footer{width:min(1280px,calc(100% - 80px));margin:auto;display:flex;align-items:center;justify-content:space-between}header{padding:34px 0;font-size:12px}.brand img{display:block;max-width:100%;height:auto}main{width:min(1100px,calc(100% - 80px));margin:80px auto 100px;display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:center}.eyebrow{font-size:11px;letter-spacing:.08em;color:#657b70}h1,h2{font-family:Optima,'Songti SC',STSong,serif;font-weight:400;letter-spacing:-.035em}h1{font-size:clamp(44px,5vw,76px);line-height:1.25;margin:20px 0 28px}h1 span{color:#567e70}.lede{font-size:16px;color:#657b70}section{padding:40px;border:1px solid #fff;border-radius:24px;background:#ffffff70;box-shadow:inset 0 1px #fff;backdrop-filter:blur(20px)}h2{font-size:30px;line-height:1.4;margin:16px 0}section>p:not(.eyebrow){font-size:13px;color:#657b70}.button{display:flex;justify-content:space-between;align-items:center;background:#173532;color:#f8f6ef;border-radius:999px;padding:12px 22px;margin:26px 0 30px;font-size:14px}.button:hover{background:#2b5149}dl{margin:0}dl div{display:flex;justify-content:space-between;border-top:1px solid #284c3b20;padding:12px 0;font-size:12px}dt{color:#657b70}dd{margin:0}.note{line-height:1.8;margin-top:20px}.link{font-size:13px;text-decoration:underline;text-underline-offset:4px}footer{padding:25px 0;border-top:1px solid #284c3b20;font-size:12px;color:#657b70}footer div{display:flex;gap:24px}
  @media(max-width:700px){header,footer,main{width:calc(100% - 40px)}header{padding:25px 0}.brand img{width:132px}main{grid-template-columns:1fr;gap:35px;margin:50px auto 65px}section{padding:28px}h1{font-size:48px}footer{align-items:flex-start;gap:18px;flex-direction:column}footer div{gap:20px}}
</style>
