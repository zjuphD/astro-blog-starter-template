<script is:inline>
(()=>{const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;const reveals=[...document.querySelectorAll('.reveal')];if('IntersectionObserver'in window&&!reduced){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in-view');io.unobserve(e.target)}}),{threshold:.12});reveals.forEach(el=>io.observe(el))}else reveals.forEach(el=>el.classList.add('in-view'));
const canvas=document.getElementById('field'),ctx=canvas?.getContext('2d'),pointer={x:-9999,y:-9999,active:false};let w=0,h=0,dpr=Math.min(devicePixelRatio||1,2),particles=[];function resize(){if(!canvas||!ctx)return;const r=canvas.getBoundingClientRect();w=r.width;h=r.height;canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);particles=Array.from({length:w<760?34:72},()=>({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.18,vy:(Math.random()-.5)*.18,r:Math.random()*1.25+.3,a:Math.random()*.55+.12,s:Math.random()*6.28}))}function draw(t=0){if(!ctx||reduced)return;ctx.clearRect(0,0,w,h);const md=w<760?110:155;for(let i=0;i<particles.length;i++){const p=particles[i];if(pointer.active){const dx=p.x-pointer.x,dy=p.y-pointer.y,d=Math.hypot(dx,dy);if(d<130&&d>0){const f=(130-d)/130*.016;p.vx+=dx/d*f;p.vy+=dy/d*f}}p.vx*=.994;p.vy*=.994;p.x+=p.vx;p.y+=p.vy;if(p.x<-10)p.x=w+10;if(p.x>w+10)p.x=-10;if(p.y<-10)p.y=h+10;if(p.y>h+10)p.y=-10;ctx.beginPath();ctx.fillStyle=`rgba(157,226,255,${p.a+Math.sin(t*.0007+p.s)*.07})`;ctx.arc(p.x,p.y,p.r,0,6.28);ctx.fill();for(let j=i+1;j<particles.length;j++){const q=particles[j],dx=p.x-q.x,dy=p.y-q.y,d=Math.hypot(dx,dy);if(d<md){const a=(1-d/md)*.09,g=ctx.createLinearGradient(p.x,p.y,q.x,q.y);g.addColorStop(0,`rgba(105,235,255,${a})`);g.addColorStop(1,`rgba(166,111,255,${a})`);ctx.strokeStyle=g;ctx.lineWidth=.65;ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);ctx.stroke()}}}requestAnimationFrame(draw)}if(canvas&&ctx){resize();if(!reduced)requestAnimationFrame(draw);addEventListener('resize',resize,{passive:true});canvas.parentElement?.addEventListener('pointermove',e=>{const r=canvas.getBoundingClientRect();pointer.x=e.clientX-r.left;pointer.y=e.clientY-r.top;pointer.active=true;document.documentElement.style.setProperty('--hero-x',`${((e.clientX-r.left)/r.width-.5)*11}px`);document.documentElement.style.setProperty('--hero-y',`${((e.clientY-r.top)/r.height-.5)*11}px`)},{passive:true});canvas.parentElement?.addEventListener('pointerleave',()=>pointer.active=false)}
const signal=document.getElementById('signal-card'),copy={GeneCode:['GENECODE','Sequence context synchronized'],Literature:['LITERATURE','Evidence graph connected'],Omics:['OMICS','Analysis workspace staged'],Methods:['METHODS','Protocol layer indexed']};document.querySelectorAll('.orbit-node').forEach(n=>n.addEventListener('click',()=>{document.querySelectorAll('.orbit-node').forEach(x=>x.classList.remove('active'));n.classList.add('active');const c=copy[n.dataset.node];if(signal&&c){signal.classList.remove('flash');void signal.offsetWidth;signal.classList.add('flash');signal.querySelector('b').textContent=c[0];signal.querySelector('p').textContent=c[1]}}));
if(!reduced&&matchMedia('(pointer:fine)').matches){document.querySelectorAll('.magnetic').forEach(el=>{el.addEventListener('pointermove',e=>{const r=el.getBoundingClientRect();el.style.transform=`translate(${(e.clientX-r.left-r.width/2)*.14}px,${(e.clientY-r.top-r.height/2)*.14}px)`});el.addEventListener('pointerleave',()=>el.style.transform='translate(0,0)')});document.querySelectorAll('.tilt-card').forEach(card=>{card.addEventListener('pointermove',e=>{const r=card.getBoundingClientRect(),px=(e.clientX-r.left)/r.width-.5,py=(e.clientY-r.top)/r.height-.5;card.style.setProperty('--rx',`${py*-2.6}deg`);card.style.setProperty('--ry',`${px*3.2}deg`);card.style.setProperty('--gx',`${(px+.5)*100}%`);card.style.setProperty('--gy',`${(py+.5)*100}%`)});card.addEventListener('pointerleave',()=>{card.style.setProperty('--rx','0deg');card.style.setProperty('--ry','0deg')})})}
const steps=[...document.querySelectorAll('.workflow-step')],logs=[...document.querySelectorAll('.log-line')];let cur=1;function setStep(n){cur=n;steps.forEach((s,i)=>s.classList.toggle('active',i<n));logs.forEach((l,i)=>l.classList.toggle('is-active',i<n))}steps.forEach((s,i)=>s.addEventListener('click',()=>setStep(i+1)));if(!reduced)setInterval(()=>setStep(cur>=4?1:cur+1),1800)})();
</script>
</body>
</html>