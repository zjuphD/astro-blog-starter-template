---
export const prerender = false;
// These domains share one Worker. Keep Aiseeki's existing landing page intact.
const host = Astro.url.hostname.toLowerCase();
const isAiseeki = host === 'aiseeki.com' || host === 'www.aiseeki.com';
return Astro.rewrite(isAiseeki ? '/aiseeki-home' : '/bioseeki-home');
---
