<script is:inline>
(function(){
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* scroll reveal */
  var revealed = document.querySelectorAll(".reveal");
  if (reduced || !("IntersectionObserver" in window)) {
    revealed.forEach(function(el){ el.classList.add("in"); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); }
      });
    }, { threshold:.15, rootMargin:"0px 0px -40px 0px" });
    revealed.forEach(function(el){ io.observe(el); });
  }

  /* nav glass on scroll */
  var nav = document.getElementById("nav");
  var onScroll = function(){ nav.classList.toggle("scrolled", window.scrollY > 24); };
  window.addEventListener("scroll", onScroll, { passive:true });
  onScroll();

  /* workflow trace loop */
  var rows = document.querySelectorAll(".trace-row");
  var steps = document.querySelectorAll(".step");
  var traceId = document.getElementById("traceId");
  if (!reduced && rows.length){
    var n = 2841, i = 0, timer = null;
    var tick = function(){
      if (i < rows.length){
        rows[i].classList.add("on");
        if (steps[i]) steps[i].classList.add("on");
        i++;
        timer = setTimeout(tick, 1150);
      } else {
        timer = setTimeout(function(){
          rows.forEach(function(r){ r.classList.remove("on"); });
          steps.forEach(function(s){ s.classList.remove("on"); });
          n++;
          traceId.textContent = "AX-0" + n;
          i = 0;
          timer = setTimeout(tick, 600);
        }, 2600);
      }
    };
    timer = setTimeout(tick, 900);
  } else if (rows.length){
    rows.forEach(function(r){ r.classList.add("on"); });
    steps.forEach(function(s){ s.classList.add("on"); });
  }
})();
</script>
