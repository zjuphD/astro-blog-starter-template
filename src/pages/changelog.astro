---
import entries from '../data/changelog.json';
import release from '../data/desktop-release.json';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>更新日志 · BioSeeki</title>
  <meta name="description" content="查看 BioSeeki 的功能更新：课题工作台、知识库与记忆、文献阅读与追踪、数据分析、实验记录和 GeneCode。" />
  <meta name="theme-color" content="#f0eee8" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="canonical" href="https://bioseeki.com/changelog" />
</head>
<body>
  <a class="skip-link" href="#updates">跳到更新内容</a>
  <header>
    <a href="/" aria-label="BioSeeki 官网"><img src="/product-assets/bioseeki-logo.svg" alt="BioSeeki" width="146" height="35" /></a>
    <nav aria-label="页面导航"><a href="/">返回官网 ↗</a><a href="/download">下载 Mac Beta ↗</a></nav>
  </header>
  <main id="updates">
    <div class="intro"><p class="eyebrow">BIOSEEKI / CHANGELOG</p><h1>更新日志</h1><p class="lede">让每一次研究，都接得上已有的进展。</p></div>
    <div class="releases">
      {entries.map(entry => (
        <article id={`v${entry.version}`} aria-labelledby={`title-${entry.version}`}>
          <div class="release-meta"><h2 id={`title-${entry.version}`}>{entry.version}<span>Mac Beta</span></h2><time datetime={entry.date}>{entry.date.replaceAll('-', '.')}</time>{entry.version === release.version && <span class="current">当前版本</span>}</div>
          <div class="release-body"><h3>{entry.title}</h3><ul>{entry.items.map(item => <li><h4>{item.feature}</h4><p>{item.description}</p></li>)}</ul></div>
        </article>
      ))}
    </div>
    <aside>使用中遇到问题？<a href="mailto:support@bioseeki.com">联系支持 ↗</a>，或在 <a href="https://github.com/zjuphD/BioSeeki/issues">GitHub 反馈 ↗</a>。</aside>
  </main>
  <footer><span>BioSeeki © 2026</span><nav aria-label="页脚导航"><a href="/download">下载</a><a href="/privacy">隐私政策</a><a href="/terms">服务条款</a></nav></footer>
</body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(html){background:#f0eee8;color:#173532;font-family:'PingFang SC','Microsoft YaHei',Arial,sans-serif;-webkit-font-smoothing:antialiased} :global(body){margin:0;line-height:1.8} :global(a){color:inherit;text-decoration:none} :global(a:hover){color:#567e70} :global(a:focus-visible){outline:2px solid #567e70;outline-offset:5px}
  .skip-link{position:absolute;top:8px;left:16px;padding:8px 16px;background:#fff;transform:translateY(-160%)}.skip-link:focus{transform:none}
  header,footer{width:min(1280px,calc(100% - 80px));margin:auto;display:flex;align-items:center;justify-content:space-between}header{padding:34px 0;font-size:12px}header img{display:block;max-width:100%;height:auto}nav{display:flex;gap:28px}
  main{width:min(980px,calc(100% - 80px));margin:80px auto 100px}.intro{margin-bottom:70px}.eyebrow{font-size:11px;letter-spacing:.1em;color:#657b70}h1,h2,h3{font-family:Optima,'Songti SC',STSong,serif;font-weight:400;letter-spacing:-.035em}h1{font-size:clamp(44px,6vw,70px);line-height:1.2;margin:20px 0 22px}.lede{color:#657b70;font-size:16px}
  article{display:grid;grid-template-columns:190px minmax(0,1fr);gap:60px;border-top:1px solid #284c3b28;padding:38px 0 48px;scroll-margin-top:24px}.release-meta h2{font-size:34px;line-height:1.15;margin:0 0 16px;font-variant-numeric:tabular-nums}.release-meta h2 span{display:block;margin-top:12px;font:12px/1.4 'PingFang SC','Microsoft YaHei',Arial,sans-serif;letter-spacing:0;color:#657b70}time{display:block;font-size:12px;color:#657b70;font-variant-numeric:tabular-nums}.current{display:block;color:#567e70;font-size:12px;margin-top:14px}.release-body h3{font-size:26px;line-height:1.4;margin:0 0 28px}.release-body ul{list-style:none;margin:0;padding:0}.release-body li+li{margin-top:24px}h4{font-size:15px;font-weight:500;margin:0 0 5px}.release-body p{font-size:14px;color:#657b70;line-height:1.9;margin:0;max-width:42em;text-wrap:pretty}aside{border-top:1px solid #284c3b28;padding-top:30px;font-size:13px;color:#657b70}aside a{text-decoration:underline;text-underline-offset:4px}footer{padding:25px 0;border-top:1px solid #284c3b20;font-size:12px;color:#657b70}
  @media(max-width:700px){header,footer,main{width:calc(100% - 40px)}header{padding:25px 0}header img{width:125px}header nav{gap:16px;font-size:11px}main{margin:50px auto 65px}.intro{margin-bottom:42px}article{grid-template-columns:1fr;gap:25px;padding:28px 0 36px}.release-meta{display:flex;align-items:baseline;flex-wrap:wrap;gap:12px 20px}.release-meta h2{font-size:28px;margin:0}.release-meta h2 span{display:inline;margin:0 0 0 10px}.current{margin:0}.release-body h3{font-size:24px;margin-bottom:24px}footer{align-items:flex-start;gap:18px;flex-direction:column}footer nav{gap:20px}}
</style>
