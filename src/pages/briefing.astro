---
import briefings from "../data/briefings.json";

const categories = [
  "全部",
  "精准医疗",
  "肿瘤生物学",
  "AI 药物发现",
  "基因组与单细胞",
  "蛋白质与结构生物学",
  "AI for Science",
];

const archiveDateOf = (item) => item.briefingDate ?? item.publishedAt;
const sorted = [...briefings].sort((a, b) =>
  archiveDateOf(b).localeCompare(archiveDateOf(a)) ||
  b.publishedAt.localeCompare(a.publishedAt) ||
  b.score - a.score
);
const latestDate = sorted[0] ? archiveDateOf(sorted[0]) : "";
const dateLabel = latestDate ? new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date(`${latestDate}T00:00:00+08:00`)) : "";
const latestMs = latestDate ? new Date(`${latestDate}T00:00:00+08:00`).getTime() : Date.now();
const todayShanghai = new Intl.DateTimeFormat("en-CA", {
  timeZone: "Asia/Shanghai",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(new Date());

function bucketFor(date) {
  const diff = Math.round((latestMs - new Date(`${date}T00:00:00+08:00`).getTime()) / 86400000);
  if (diff <= 0) return "today";
  if (diff === 1) return "yesterday";
  if (diff <= 6) return "week";
  return "history";
}

function bucketLabel(bucket) {
  if (bucket === "today") return latestDate === todayShanghai ? "今日精选" : "最新一期";
  if (bucket === "yesterday") return latestDate === todayShanghai ? "昨日" : "上一期";
  if (bucket === "week") return "本周";
  return "历史快讯";
}

const bucketOrder = ["today", "yesterday", "week", "history"];
const groups = bucketOrder
  .map(bucket => ({ bucket, label: bucketLabel(bucket), items: sorted.filter(item => bucketFor(archiveDateOf(item)) === bucket) }))
  .filter(group => group.items.length > 0);
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Aiseeki 前沿快讯｜AI for Science Daily</title>
  <meta name="description" content="每日筛选精准医疗、肿瘤生物学、AI 药物发现、组学、结构生物学与 AI for Science 的重要新进展。" />
  <link rel="icon" type="image/png" href="/aiseeki-redesign-assets/favicon-64.png" />
  <style is:global>
    :root{--bg:#EEF0EA;--ink:#24312B;--soft:#5A6A62;--sage:#6E8F7C;--sage2:#54745F;--ochre:#C08A2D;--line:rgba(36,49,43,.13);--glass:rgba(255,255,255,.58);--glass2:rgba(255,255,255,.78);--shadow:rgba(36,49,43,.10)}
    @media(prefers-color-scheme:dark){:root{--bg:#141A17;--ink:#E9ECE5;--soft:#A7B4AB;--sage:#8FB49F;--sage2:#A9CBB8;--ochre:#D9A94E;--line:rgba(233,236,229,.13);--glass:rgba(30,38,34,.55);--glass2:rgba(34,43,38,.78);--shadow:rgba(0,0,0,.42)}}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:"PingFang SC","Microsoft YaHei","Noto Sans SC",system-ui,sans-serif;line-height:1.72;-webkit-font-smoothing:antialiased;overflow-x:hidden}a{color:inherit;text-decoration:none}
    body:before,body:after{content:"";position:fixed;z-index:-2;border-radius:50%;filter:blur(100px);pointer-events:none}body:before{width:52vw;height:52vw;left:-12vw;top:-16vw;background:rgba(110,143,124,.34)}body:after{width:44vw;height:44vw;right:-14vw;top:34vh;background:rgba(192,138,45,.20)}
    .wrap{width:min(1160px,calc(100% - 36px));margin:auto}.glass{background:var(--glass);backdrop-filter:blur(18px) saturate(1.3);border:1px solid var(--line);box-shadow:0 10px 34px var(--shadow);border-radius:20px}
    .nav{position:sticky;top:14px;z-index:20;margin-top:14px;padding:10px 12px 10px 18px;display:flex;align-items:center;gap:16px;background:var(--glass2);backdrop-filter:blur(18px);border:1px solid var(--line);border-radius:16px}.brand{display:flex;align-items:center;gap:10px;margin-right:auto}.brand img{width:38px}.brand b{letter-spacing:.18em}.brand small{color:var(--soft);font-size:.68rem}.nav a:not(.brand){font-size:.88rem;color:var(--soft)}.nav .cta{padding:8px 14px;border-radius:999px;background:var(--ink);color:var(--bg)!important;font-weight:600}
    .hero{padding:8rem 0 3.4rem}.eyebrow{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em;color:var(--soft);font-size:.72rem}.hero h1{font-size:clamp(2.5rem,6vw,4.7rem);line-height:1.08;letter-spacing:-.04em;margin:.7rem 0 1rem}.hero h1 em{font-style:normal;color:var(--sage2)}.lede{max-width:760px;color:var(--soft);font-size:1.08rem}.hero-meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:1.4rem}.pill{padding:7px 12px;border:1px solid var(--line);border-radius:999px;background:var(--glass);font-size:.76rem;color:var(--soft)}
    .control-row{display:flex;justify-content:space-between;align-items:flex-end;gap:18px;flex-wrap:wrap;margin:0 0 2.2rem}.filter-block{min-width:0}.control-label{font-size:.7rem;color:var(--soft);letter-spacing:.08em;margin-bottom:.6rem}.filters,.time-filters{display:flex;gap:8px;flex-wrap:wrap}.filter,.time-filter{border:1px solid var(--line);background:var(--glass);color:var(--soft);padding:8px 13px;border-radius:999px;cursor:pointer;font:inherit;font-size:.82rem;transition:transform .2s ease,background .2s ease,color .2s ease}.filter:hover,.time-filter:hover{transform:translateY(-1px)}.filter.active,.time-filter.active{background:var(--ink);color:var(--bg)}
    .period{margin-bottom:4.2rem}.period[hidden]{display:none}.period-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin:0 0 1.2rem;padding-bottom:.85rem;border-bottom:1px solid var(--line)}.period-title{font-size:clamp(1.45rem,3vw,2.15rem);letter-spacing:-.025em;margin:0}.period-meta{font-size:.75rem;color:var(--soft);white-space:nowrap}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:20px;perspective:1400px}
    .brief{--rx:0deg;--ry:0deg;--mx:50%;--my:50%;grid-column:span 6;position:relative;overflow:hidden;display:flex;flex-direction:column;min-height:540px;transform:perspective(1000px) rotateX(var(--rx)) rotateY(var(--ry));transform-style:preserve-3d;transition:transform .18s ease,box-shadow .3s ease,border-color .3s ease}.brief:hover{box-shadow:0 24px 58px var(--shadow);border-color:color-mix(in srgb,var(--sage) 42%,var(--line))}.brief:after{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;background:radial-gradient(420px circle at var(--mx) var(--my),rgba(255,255,255,.26),transparent 45%);transition:opacity .25s ease;z-index:4}.brief:hover:after{opacity:1}.brief.featured{grid-column:span 12;display:grid;grid-template-columns:1.08fr .92fr;min-height:430px}.brief.featured .cover-shot{height:100%;min-height:430px;border-radius:20px 0 0 20px}.brief.featured .brief-body{padding:1.8rem 1.8rem 1.7rem 1.5rem}.brief-body{padding:1.35rem 1.45rem 1.45rem;display:flex;flex-direction:column;flex:1;position:relative;z-index:2;transform:translateZ(18px)}
    .cover-shot{position:relative;height:238px;overflow:hidden;background:linear-gradient(135deg,color-mix(in srgb,var(--sage) 18%,var(--bg)),color-mix(in srgb,var(--ochre) 12%,var(--bg)));border-bottom:1px solid var(--line);isolation:isolate}.cover-shot img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.86) contrast(.96);transform:scale(1.02);transition:transform .7s cubic-bezier(.2,.7,.2,1),filter .4s ease}.brief:hover .cover-shot img{transform:scale(1.075);filter:saturate(1) contrast(1)}.cover-shot:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.04),rgba(0,0,0,.04) 45%,rgba(0,0,0,.48));z-index:1;pointer-events:none}.browser-bar{position:absolute;left:12px;right:12px;top:12px;z-index:3;display:flex;align-items:center;gap:7px;padding:7px 10px;border-radius:10px;background:rgba(245,247,243,.82);backdrop-filter:blur(12px);box-shadow:0 5px 20px rgba(0,0,0,.14);color:#344039;font-size:.66rem}.browser-dots{display:flex;gap:4px}.browser-dots i{display:block;width:6px;height:6px;border-radius:50%;background:#9EA9A2}.browser-url{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;opacity:.78}.cover-label{position:absolute;z-index:3;left:16px;bottom:14px;right:16px;display:flex;align-items:end;justify-content:space-between;gap:12px;color:white;text-shadow:0 2px 14px rgba(0,0,0,.3)}.cover-label strong{font-size:.86rem}.cover-label span{font-size:.66rem;opacity:.8;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.cover-fallback{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:56px 18px 18px;z-index:0}.cover-fallback b{font-size:1.4rem;line-height:1.3;max-width:18ch;color:var(--ink)}.cover-fallback span{margin-top:8px;color:var(--soft);font-size:.72rem}.cover-shot.has-error img{display:none}
    .topline{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:.9rem}.cat{font-size:.7rem;letter-spacing:.08em;color:var(--sage2);font-weight:700}.type{font-size:.68rem;color:var(--soft)}.score{margin-left:auto;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.72rem;color:var(--ochre)}.brief h2{font-size:clamp(1.25rem,2.4vw,1.72rem);line-height:1.38;margin:.2rem 0 .7rem}.brief.featured h2{font-size:clamp(1.8rem,3.2vw,2.55rem)}.source{font-size:.78rem;color:var(--soft);margin-bottom:1rem}.summary{color:var(--soft);margin:0 0 1rem}.why{padding:12px 14px;border-radius:14px;background:rgba(110,143,124,.09);border:1px solid var(--line);font-size:.9rem}.why b{display:block;color:var(--ink);margin-bottom:3px}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto;padding-top:1rem}.tag{font-size:.68rem;color:var(--soft);border:1px solid var(--line);border-radius:999px;padding:4px 9px}.read{display:inline-flex;margin-top:1rem;font-size:.86rem;font-weight:700;color:var(--sage2);transition:transform .2s ease}.read:hover{transform:translateX(3px)}
    .empty{display:none;text-align:center;padding:4rem 1rem 6rem;color:var(--soft)}footer{padding:1rem 0 4rem;color:var(--soft);font-size:.78rem;text-align:center}
    @media(max-width:800px){.nav small,.nav a:not(.brand):not(.cta){display:none}.hero{padding-top:6rem}.control-row{align-items:stretch}.brief,.brief.featured{grid-column:span 12;display:flex;min-height:auto;transform:none!important}.brief.featured .cover-shot,.cover-shot{height:220px;min-height:0;border-radius:20px 20px 0 0}.brief.featured .brief-body{padding:1.35rem 1.45rem 1.45rem}.brief.featured h2{font-size:1.7rem}.brief:after{display:none}.period-head{align-items:flex-start;flex-direction:column;gap:2px}}
    @media(prefers-reduced-motion:reduce){.brief,.brief:hover{transform:none!important;transition:none}.cover-shot img,.brief:hover .cover-shot img{transform:none;transition:none}.brief:after{display:none}.filter,.time-filter{transition:none}}
  </style>
</head>
<body>
  <div class="wrap">
    <nav class="nav">
      <a class="brand" href="/"><img src="/aiseeki-redesign-assets/logo-mark.png" alt="" /><b>AISEEKI</b><small>AI FOR SCIENCE DAILY</small></a>
      <a href="/">首页</a><a href="/briefing">前沿快讯</a><a href="https://github.com/zjuphD/GeneCode" target="_blank" rel="noopener">GitHub</a>
      <a class="cta" href="https://genecode-agent.pages.dev" target="_blank" rel="noopener">GeneCode ↗</a>
    </nav>

    <header class="hero">
      <p class="eyebrow">AISEEKI INTELLIGENCE · DAILY SIGNAL</p>
      <h1>每天过滤噪音，留下<em>值得科研人员看的进展</em>。</h1>
      <p class="lede">聚焦精准医疗、肿瘤生物学、AI 药物发现、组学、结构生物学与 AI for Science。每一天的入选结果独立归档，论文发表日期和快讯入选日期分开记录。</p>
      <div class="hero-meta"><span class="pill">最近一期 · {dateLabel}</span><span class="pill">{sorted.length} 条精选</span><span class="pill">自动快讯保留 21 天</span></div>
    </header>

    <div class="control-row">
      <div class="filter-block">
        <div class="control-label">按主题</div>
        <div class="filters" aria-label="快讯分类筛选">
          {categories.map((category, index) => <button class:list={["filter", { active: index === 0 }]} data-filter={category}>{category}</button>)}
        </div>
      </div>
      <div class="filter-block">
        <div class="control-label">按时间</div>
        <div class="time-filters" aria-label="快讯时间筛选">
          <button class="time-filter active" data-time="all">全部</button>
          <button class="time-filter" data-time="today">今日</button>
          <button class="time-filter" data-time="yesterday">昨日</button>
          <button class="time-filter" data-time="week">7 天内</button>
          <button class="time-filter" data-time="history">更早</button>
        </div>
      </div>
    </div>

    <main id="briefingGrid">
      {groups.map(group => (
        <section class="period" data-period={group.bucket}>
          <div class="period-head">
            <h2 class="period-title">{group.label}</h2>
            <div class="period-meta"><span data-visible-count>{group.items.length}</span> 条 · {archiveDateOf(group.items[0])}{group.items.length > 1 && archiveDateOf(group.items.at(-1)) !== archiveDateOf(group.items[0]) ? ` — ${archiveDateOf(group.items.at(-1))}` : ""}</div>
          </div>
          <div class="grid">
            {group.items.map((item, index) => {
              const host = new URL(item.originalUrl).hostname.replace(/^www\./, "");
              const cover = `/briefing-covers/${item.id}.png`;
              const featured = group.bucket === "today" && index === 0;
              return (
                <article class:list={["glass", "brief", { featured }]} data-category={item.category} data-period-card={group.bucket} data-tilt>
                  <div class="cover-shot">
                    <div class="cover-fallback"><b>{item.source}</b><span>{host}</span></div>
                    <img src={cover} alt={`${item.source} 来源页面预览`} loading={featured ? "eager" : "lazy"} data-cover />
                    <div class="browser-bar"><span class="browser-dots"><i></i><i></i><i></i></span><span class="browser-url">{host}</span></div>
                    <div class="cover-label"><strong>{item.source}</strong><span>SOURCE SNAPSHOT</span></div>
                  </div>
                  <div class="brief-body">
                    <div class="topline"><span class="cat">{item.category}</span><span class="type">· {item.sourceType}</span><span class="score">AISK / {item.score}</span></div>
                    <h2>{item.titleZh}</h2>
                    <p class="source">{item.source} · 论文发布 {item.publishedAt}</p>
                    <p class="summary">{item.summary}</p>
                    <div class="why"><b>为什么值得关注</b>{item.whyItMatters}</div>
                    <div class="tags">{item.tags.map(tag => <span class="tag">{tag}</span>)}</div>
                    <a class="read" href={item.originalUrl} target="_blank" rel="noopener noreferrer">查看原始来源 ↗</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
      <div class="empty" id="emptyState">当前筛选条件下没有快讯。</div>
    </main>

    <footer>© 2026 AISEEKI · AI for Research · 快讯仅用于科研信息整理，不替代原始论文与专业判断。</footer>
  </div>

  <script is:inline>
    (function(){
      var categoryButtons = document.querySelectorAll('[data-filter]');
      var timeButtons = document.querySelectorAll('[data-time]');
      var cards = document.querySelectorAll('[data-period-card]');
      var periods = document.querySelectorAll('[data-period]');
      var empty = document.getElementById('emptyState');
      var currentCategory = '全部';
      var currentTime = 'all';

      function timeMatch(card){
        var p = card.getAttribute('data-period-card');
        if(currentTime === 'all') return true;
        if(currentTime === 'week') return p === 'today' || p === 'yesterday' || p === 'week';
        return p === currentTime;
      }

      function applyFilters(){
        var total = 0;
        cards.forEach(function(card){
          var catMatch = currentCategory === '全部' || card.getAttribute('data-category') === currentCategory;
          var show = catMatch && timeMatch(card);
          card.style.display = show ? '' : 'none';
          if(show) total++;
        });

        periods.forEach(function(period){
          var visible = Array.from(period.querySelectorAll('[data-period-card]')).filter(function(card){ return card.style.display !== 'none'; });
          period.hidden = visible.length === 0;
          var count = period.querySelector('[data-visible-count]');
          if(count) count.textContent = String(visible.length);
        });

        empty.style.display = total ? 'none' : 'block';
      }

      categoryButtons.forEach(function(btn){
        btn.addEventListener('click', function(){
          categoryButtons.forEach(function(b){ b.classList.remove('active'); });
          btn.classList.add('active');
          currentCategory = btn.getAttribute('data-filter');
          applyFilters();
        });
      });

      timeButtons.forEach(function(btn){
        btn.addEventListener('click', function(){
          timeButtons.forEach(function(b){ b.classList.remove('active'); });
          btn.classList.add('active');
          currentTime = btn.getAttribute('data-time');
          applyFilters();
        });
      });

      document.querySelectorAll('[data-cover]').forEach(function(img){
        img.addEventListener('error', function(){
          var cover = img.closest('.cover-shot');
          if(cover) cover.classList.add('has-error');
        });
      });

      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var finePointer = window.matchMedia('(pointer: fine)').matches;
      if(!reduced && finePointer){
        document.querySelectorAll('[data-tilt]').forEach(function(card){
          card.addEventListener('pointermove', function(e){
            var r = card.getBoundingClientRect();
            var x = (e.clientX - r.left) / r.width;
            var y = (e.clientY - r.top) / r.height;
            card.style.setProperty('--ry', ((x - .5) * 5.5).toFixed(2) + 'deg');
            card.style.setProperty('--rx', ((.5 - y) * 4.5).toFixed(2) + 'deg');
            card.style.setProperty('--mx', (x * 100).toFixed(1) + '%');
            card.style.setProperty('--my', (y * 100).toFixed(1) + '%');
          });
          card.addEventListener('pointerleave', function(){
            card.style.setProperty('--ry', '0deg');
            card.style.setProperty('--rx', '0deg');
            card.style.setProperty('--mx', '50%');
            card.style.setProperty('--my', '50%');
          });
        });
      }
    })();
  </script>
</body>
</html>
