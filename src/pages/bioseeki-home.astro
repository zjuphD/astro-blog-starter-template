---
export const prerender = false;
import Home from "../components/bioseeki/Home.astro";
import { detectLang } from "../i18n/bioseeki";

// `/` on bioseeki.com lands here (index.astro rewrites by host). Language comes from
// ?lang= (remembered in a cookie), then the cookie, then Accept-Language; default zh.
const lang = detectLang(Astro);
Astro.response.headers.set("Vary", "Accept-Language, Cookie");
---
<Home lang={lang} />
