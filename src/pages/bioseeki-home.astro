<script is:inline>
(function(){
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* scroll reveal */
  var revealed = document.querySelectorAll(".reveal");
  if (reduced || !("IntersectionObserver" in window)) {
    revealed.forEach(function(el){ el.classList.add("in"); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add("in"); io.unobserve(e.target); }
      });
    }, { threshold:.15, rootMargin:"0px 0px -40px 0px" });
    revealed.forEach(function(el){ io.observe(el); });
  }

  /* nav glass on scroll */
  var nav = document.getElementById("nav");
  var onScroll = function(){ nav.classList.toggle("scrolled", window.scrollY > 24); };
  window.addEventListener("scroll", onScroll, { passive:true });
  onScroll();

  /* nav: mark the section that crosses the upper-middle of the viewport */
  var links = Array.prototype.slice.call(document.querySelectorAll('.nav-links a[href^="#"]'));
  var targets = links.map(function(a){ return document.getElementById(a.getAttribute("href").slice(1)); });
  var spyQueued = false;
  function spy(){
    spyQueued = false;
    var line = window.innerHeight * 0.45;
    links.forEach(function(a, i){
      var t = targets[i], r = t && t.getBoundingClientRect();
      if (r && r.top <= line && r.bottom > line) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    });
  }
  window.addEventListener("scroll", function(){ if (!spyQueued){ spyQueued = true; requestAnimationFrame(spy); } }, { passive:true });
  spy();

  /* hero session: light the steps one by one, replay while visible */
  var rows = document.querySelectorAll("#hero-panel .ht-row");
  if (reduced || !rows.length){
    rows.forEach(function(r){ r.classList.add("on"); });
    return;
  }
  var panel = document.getElementById("hero-panel");
  var visible = true, timer = null;
  function play(){
    clearTimeout(timer);
    rows.forEach(function(r){ r.classList.remove("on"); });
    var i = 0;
    (function next(){
      if (i < rows.length){ rows[i++].classList.add("on"); timer = setTimeout(next, 900); }
      else { timer = setTimeout(function(){ if (visible && !document.hidden) play(); }, 6000); }
    })();
  }
  if ("IntersectionObserver" in window){
    new IntersectionObserver(function(entries){
      var was = visible; visible = entries[0].isIntersecting;
      if (visible && !was) play();
    }, { threshold:.3 }).observe(panel);
  }
  document.addEventListener("visibilitychange", function(){ if (!document.hidden && visible) play(); });
  setTimeout(play, 700);
})();
</script>
</body>
</html>
